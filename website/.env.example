# Copy this file to .env.local for `npm run dev`. .env.local is git-ignored.
# On Vercel, set the same names under Project > Settings > Environment Variables.
# None of these may start with NEXT_PUBLIC_: they are all server-side secrets.

# Optional. Feedback is delivered with FormSubmit (no key) to
# kabuyatambwe03@gmail.com from app/api/feedback/route.ts.
# If you also want Web3Forms, create a key at https://web3forms.com
# for that inbox and set it here for local `npm run dev`.
WEB3FORMS_ACCESS_KEY=

# --- New-version email announcements ---

# Supabase > Project Settings > Data API > Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Supabase > Project Settings > API Keys > Secret key (sb_secret_…), or the legacy
# service_role key. NOT the publishable/anon key. Never share it.
SUPABASE_SECRET_KEY=

# Resend > API Keys > Create API key (permission: Sending access).
RESEND_API_KEY=
# Sender on your verified Resend domain, e.g. MessageFlow Media <updates@messageflow.tech>
RESEND_FROM=

# A long random string (at least 32 characters). The same value goes in the GitHub
# repository secret ANNOUNCE_SECRET, which lets the release workflow trigger emails.
ANNOUNCE_SECRET=

# Optional. Base URL for links in emails; defaults to https://www.messageflow.tech.
# For local testing set http://localhost:3000.
SITE_URL=

# Optional. A GitHub token with read access to public repos, only needed if the
# GitHub API rate-limits the website's release check.
GITHUB_TOKEN=
