# Build output
bin/
obj/
**/bin/
**/obj/

# IDE/user files
.vs/
*.user
*.suo

# Local installer tooling and external release/archive folders
Inno Setup 6/
D:/MessageFlow Archive/
D:/MessageFlow Release/
D:\MessageFlow Archive\
D:\MessageFlow Release\

# Logs, temporary files, and backups
*.log
*.tmp
*.bak

# SQLite sidecar files
*.db-shm
*.db-wal
database/*.db-shm
database/*.db-wal

# Local database backups are not source artifacts. Keep the production
# database explicit so it can be intentionally tracked or release-only.
database/*.db
!database/messageflow.db

# Do not blanket-ignore database/messageflow.db here. If the production
# database is intentionally bundled, decide explicitly whether it belongs in
# source control or only in release installer assets.
