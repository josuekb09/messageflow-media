# Build output
bin/
obj/
**/bin/
**/obj/
artifacts/
dist/

# IDE/user files
.vs/
*.user
*.suo

# Local installer tooling and external release/archive folders
Inno Setup 6/

# Logs, temporary files, and backups
*.log
*.tmp
*.bak

# SQLite sidecar files
*.db-shm
*.db-wal
database/*.db-shm
database/*.db-wal

# Local database backups are not source artifacts. Keep the production
# database explicit so it can be intentionally tracked or release-only.
database/*.db
/database/messageflow.db

# The production database is validated and bundled by the release tooling,
# but is intentionally excluded from source control.
