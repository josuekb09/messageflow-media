<Window x:Class="MessageFlow.App.AddContentSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MessageFlow.App.Localization"
        Title="{loc:Tr AddSource_Title}"
        Height="520"
        Width="560"
        MinHeight="480"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Add New Source"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="Register a local content folder for future imports."
                       Margin="0,7,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="14"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Display Name"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBox x:Name="DisplayNameBox"
                         Margin="0,7,0,16"
                         VerticalContentAlignment="Center" />

                <TextBlock Text="Source Type"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <ComboBox x:Name="SourceTypeBox"
                          Margin="0,7,0,16"
                          DisplayMemberPath="Label"
                          TextSearch.TextPath="Label"
                          SelectionChanged="SourceTypeBox_SelectionChanged"
                          VerticalContentAlignment="Center" />

                <TextBlock Text="Description"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBox x:Name="DescriptionBox"
                         Margin="0,7,0,16"
                         MinHeight="120"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Local Folder Path"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <Grid Margin="0,7,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="124" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="LocalFolderPathBox"
                             Grid.Column="0"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="2"
                            Content="Browse"
                            Click="Browse_Click" />
                </Grid>
                <TextBlock x:Name="FolderSuggestionText"
                           Margin="0,0,0,16"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="13"
                           LineHeight="18"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="142" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ValidationMessage"
                       Grid.Column="0"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <Button Grid.Column="2"
                    Content="Cancel"
                    Background="{DynamicResource DisabledBackgroundBrush}"
                    BorderBrush="{DynamicResource DisabledBackgroundBrush}"
                    Click="Cancel_Click" />
            <Button Grid.Column="4"
                    Content="Save Source"
                    Click="Save_Click" />
        </Grid>
    </Grid>
</Window>
