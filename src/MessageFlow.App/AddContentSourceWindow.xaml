<Window x:Class="MessageFlow.App.AddContentSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Source"
        Height="520"
        Width="620"
        MinHeight="480"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        ResizeMode="CanResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Add New Source"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="Register a local content folder for future imports."
                       Margin="0,7,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="14" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Display Name"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBox x:Name="DisplayNameBox"
                     Grid.Row="1"
                     Margin="0,7,0,16"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="2"
                       Text="Source Type"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <ComboBox x:Name="SourceTypeBox"
                      Grid.Row="3"
                      Margin="0,7,0,16"
                      DisplayMemberPath="Label"
                      TextSearch.TextPath="Label"
                      VerticalContentAlignment="Center" />

            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Description"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBox x:Name="DescriptionBox"
                         Grid.Row="1"
                         Margin="0,7,0,16"
                         MinHeight="86"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Grid.Row="2"
                           Text="Local Folder Path"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <Grid Grid.Row="3" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="LocalFolderPathBox"
                             Grid.Column="0"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="2"
                            Content="Browse"
                            Click="Browse_Click" />
                </Grid>
            </Grid>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,22,0,0">
            <TextBlock x:Name="ValidationMessage"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="110"
                        Background="{StaticResource DisabledBackgroundBrush}"
                        BorderBrush="{StaticResource DisabledBackgroundBrush}"
                        Click="Cancel_Click" />
                <Button Content="Save Source"
                        Width="140"
                        Margin="12,0,0,0"
                        Click="Save_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
