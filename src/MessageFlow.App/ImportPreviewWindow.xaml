<Window x:Class="MessageFlow.App.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MessageFlow.App.Localization"
        Title="{loc:Tr ImportPreview_Title}"
        Height="560"
        Width="640"
        MinHeight="500"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{loc:Tr ImportPreview_Title}"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding WarningText, Mode=OneWay}"
                       Margin="0,7,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="14"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Padding="16"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Source"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SourceDisplayName, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1"
                                   Text="Type"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding SourceTypeDisplay, Mode=OneWay}"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2"
                                   Text="Folder"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding LocalFolderPath, Mode=OneWay}"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="3"
                                   Text="Estimated author"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13" />
                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Text="{Binding EstimatedAuthorName, Mode=OneWay}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Padding="16"
                        Margin="0,16,0,0"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PDF files found"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13" />
                            <TextBlock Text="{Binding PdfFilesFound, StringFormat={}{0:N0}, Mode=OneWay}"
                                       Margin="0,6,0,0"
                                       FontSize="28"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ready to import"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13" />
                            <TextBlock Text="{Binding ReadyToImportFiles, StringFormat={}{0:N0}, Mode=OneWay}"
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="28"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,18,0,0">
                            <TextBlock Text="Already imported"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13" />
                            <TextBlock Text="{Binding AlreadyImportedFiles, StringFormat={}{0:N0}, Mode=OneWay}"
                                       Margin="0,6,0,0"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,18,0,0">
                            <TextBlock Text="Invalid or missing"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13" />
                            <TextBlock Text="{Binding InvalidOrMissingFilesCount, StringFormat={}{0:N0}, Mode=OneWay}"
                                       Margin="0,6,0,0"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Padding="16"
                        Margin="0,16,0,0"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsQualityPreviewAvailable, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Brother Frank paragraph quality preview"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Total extracted paragraphs"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13" />
                            <TextBlock Grid.Row="1"
                                       Text="{Binding QualitySummary.TotalExtractedParagraphs, StringFormat={}{0:N0}, Mode=OneWay}"
                                       Margin="0,6,0,0"
                                       FontSize="22"
                                       FontWeight="SemiBold" />

                            <TextBlock Grid.Column="1"
                                       Text="Accepted paragraphs"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding QualitySummary.AcceptedParagraphs, StringFormat={}{0:N0}, Mode=OneWay}"
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="22"
                                       FontWeight="SemiBold" />

                            <TextBlock Grid.Column="2"
                                       Text="Rejected page numbers"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Text="{Binding QualitySummary.RejectedPageNumbers, StringFormat={}{0:N0}, Mode=OneWay}"
                                       Margin="0,6,0,0"
                                       FontSize="22"
                                       FontWeight="SemiBold" />

                            <TextBlock Grid.Row="2"
                                       Text="Rejected corrupted text"
                                       Margin="0,16,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13" />
                            <TextBlock Grid.Row="3"
                                       Text="{Binding QualitySummary.RejectedCorruptedText, StringFormat={}{0:N0}, Mode=OneWay}"
                                       Margin="0,6,0,0"
                                       FontSize="22"
                                       FontWeight="SemiBold" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="Rejected headers/footers"
                                       Margin="0,16,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Text="{Binding QualitySummary.RejectedHeadersFooters, StringFormat={}{0:N0}, Mode=OneWay}"
                                       Margin="0,6,0,0"
                                       FontSize="22"
                                       FontWeight="SemiBold" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Text="Rejected too short"
                                       Margin="0,16,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="2"
                                       Text="{Binding QualitySummary.RejectedTooShort, StringFormat={}{0:N0}, Mode=OneWay}"
                                       Margin="0,6,0,0"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Padding="16"
                        Margin="0,16,0,0"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Sample parsed metadata"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding MetadataSamples, Mode=OneWay}"
                                      Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12"
                                            Margin="0,0,0,10"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.ColumnSpan="2"
                                                       Text="{Binding FileName, Mode=OneWay}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />

                                            <TextBlock Grid.Row="1"
                                                       Text="Title"
                                                       Margin="0,8,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="13" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Text="{Binding DetectedTitle, Mode=OneWay}"
                                                       Margin="0,8,0,0"
                                                       TextWrapping="Wrap" />

                                            <TextBlock Grid.Row="2"
                                                       Text="Code / Year"
                                                       Margin="0,6,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="13" />
                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="1"
                                                       Margin="0,6,0,0"
                                                       TextWrapping="Wrap">
                                                <Run Text="{Binding DetectedCode, Mode=OneWay}" />
                                                <Run Text=" / " />
                                                <Run Text="{Binding DetectedYearDisplay, Mode=OneWay}" />
                                            </TextBlock>

                                            <TextBlock Grid.Row="3"
                                                       Text="Author"
                                                       Margin="0,6,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="13" />
                                            <TextBlock Grid.Row="3"
                                                       Grid.Column="1"
                                                       Text="{Binding DetectedAuthor, Mode=OneWay}"
                                                       Margin="0,6,0,0"
                                                       TextWrapping="Wrap" />

                                            <TextBlock Grid.Row="4"
                                                       Text="Type / Status"
                                                       Margin="0,6,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="13" />
                                            <TextBlock Grid.Row="4"
                                                       Grid.Column="1"
                                                       Margin="0,6,0,0"
                                                       TextWrapping="Wrap">
                                                <Run Text="{Binding DetectedSourceType, Mode=OneWay}" />
                                                <Run Text=" / " />
                                                <Run Text="{Binding Status, Mode=OneWay}" />
                                            </TextBlock>

                                            <TextBlock Grid.Row="5"
                                                       Grid.ColumnSpan="2"
                                                       Text="{Binding WarningDisplay, Mode=OneWay}"
                                                       Margin="0,8,0,0"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Padding="16"
                        Margin="0,16,0,0"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Invalid or missing files"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding InvalidOrMissingFilesDisplay, Mode=OneWay}"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   LineHeight="18"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Cancel stops here. Start Import writes only new local PDFs to the database."
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <Button Grid.Column="1"
                    Content="{Binding CancelButtonText, Mode=OneWay}"
                    Background="{StaticResource DisabledBackgroundBrush}"
                    BorderBrush="{StaticResource DisabledBackgroundBrush}"
                    Click="Cancel_Click" />
            <Button Grid.Column="3"
                    Content="Start Import"
                    IsEnabled="{Binding CanStartImport, Mode=OneWay}"
                    Click="StartImport_Click" />
        </Grid>
    </Grid>
</Window>
