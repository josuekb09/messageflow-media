<Window x:Class="MessageFlow.App.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Preview"
        Height="620"
        Width="700"
        MinHeight="560"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        ResizeMode="CanResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Import Preview"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding WarningText}"
                       Margin="0,7,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="14"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Padding="16"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Source"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SourceDisplayName}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1"
                                   Text="Type"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding SourceTypeDisplay}"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2"
                                   Text="Folder"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding LocalFolderPath}"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="3"
                                   Text="Estimated author"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13" />
                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Text="{Binding EstimatedAuthorName}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Padding="16"
                        Margin="0,16,0,0"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PDF files found"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13" />
                            <TextBlock Text="{Binding PdfFilesFound, StringFormat={}{0:N0}}"
                                       Margin="0,6,0,0"
                                       FontSize="28"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ready to import"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13" />
                            <TextBlock Text="{Binding ReadyToImportFiles, StringFormat={}{0:N0}}"
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="28"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,18,0,0">
                            <TextBlock Text="Already imported"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13" />
                            <TextBlock Text="{Binding AlreadyImportedFiles, StringFormat={}{0:N0}}"
                                       Margin="0,6,0,0"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,18,0,0">
                            <TextBlock Text="Invalid or missing"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13" />
                            <TextBlock Text="{Binding InvalidOrMissingFilesCount, StringFormat={}{0:N0}}"
                                       Margin="0,6,0,0"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Padding="16"
                        Margin="0,16,0,0"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Invalid or missing files"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding InvalidOrMissingFilesDisplay}"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   LineHeight="18"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Cancel stops here. Start Import writes only new local PDFs to the database."
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <Button Grid.Column="1"
                    Content="Cancel"
                    Background="{StaticResource DisabledBackgroundBrush}"
                    BorderBrush="{StaticResource DisabledBackgroundBrush}"
                    Click="Cancel_Click" />
            <Button Grid.Column="3"
                    Content="Start Import"
                    IsEnabled="{Binding CanStartImport}"
                    Click="StartImport_Click" />
        </Grid>
    </Grid>
</Window>
