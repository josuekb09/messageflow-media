<Window x:Class="MessageFlow.App.ImportBibleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MessageFlow.App.Localization"
        Title="{loc:Tr ImportBible_Title}"
        Height="850"
        Width="1200"
        MinHeight="780"
        MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{loc:Tr ImportBible_Title}"
                           FontSize="26"
                           FontWeight="SemiBold" />
                <TextBlock Text="{loc:Tr ImportBible_Subtitle}"
                           Margin="0,6,0,6"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="14"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SuggestedFileText"
                           Text="{loc:Tr ImportBible_SuggestedFile}"
                           Margin="0,0,0,20"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Visibility="Collapsed"
                           TextWrapping="Wrap" />

                <Border Padding="{StaticResource CardPadding}"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource BorderRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{loc:Tr ImportBible_TranslationName}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" />
                        <TextBox x:Name="TranslationNameBox"
                                 Grid.Row="1"
                                 Text="King James Version"
                                 Margin="0,6,0,0"
                                 TextChanged="InputChanged" />

                        <TextBlock Grid.Column="2"
                                   Text="{loc:Tr ImportBible_Abbreviation}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" />
                        <TextBox x:Name="AbbreviationBox"
                                 Grid.Row="1"
                                 Grid.Column="2"
                                 Text="KJV"
                                 Margin="0,6,0,0"
                                 TextChanged="InputChanged" />

                        <TextBlock Grid.Column="4"
                                   Text="{loc:Tr ImportBible_Language}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" />
                        <TextBox x:Name="LanguageBox"
                                 Grid.Row="1"
                                 Grid.Column="4"
                                 Text="English"
                                 Margin="0,6,0,0"
                                 TextChanged="InputChanged" />

                        <TextBlock Grid.Row="2"
                                   Grid.ColumnSpan="5"
                                   Text="{loc:Tr Common_Description}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   Margin="0,16,0,6" />
                        <TextBox x:Name="DescriptionBox"
                                 Grid.Row="3"
                                 Grid.ColumnSpan="5"
                                 Text="King James Version local CSV import."
                                 MinHeight="32"
                                 TextChanged="InputChanged" />

                        <TextBlock Grid.Row="4"
                                   Grid.ColumnSpan="5"
                                   Text="{loc:Tr ImportBible_CsvFile}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   Margin="0,16,0,6" />
                        <Grid Grid.Row="5"
                              Grid.ColumnSpan="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FilePathBox"
                                     VerticalContentAlignment="Center"
                                     TextChanged="InputChanged" />
                            <Button Grid.Column="2"
                                    Content="{loc:Tr Common_Browse}"
                                    Click="Browse_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Margin="0,22,0,0"
                        Padding="{StaticResource CardPadding}"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource BorderRadius}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="{loc:Tr Common_Preview}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       DockPanel.Dock="Left" />
                            <TextBlock x:Name="PreviewStatusText"
                                       Text="{loc:Tr ImportBible_ChooseFileHint}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="13"
                                       HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <Grid Margin="0,18,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Padding="14"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource BorderRadius}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr ImportBible_Translation}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12" />
                                    <TextBlock x:Name="PreviewTranslationText"
                                               Text="-"
                                               Margin="0,5,0,0"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Margin="14,0,0,0"
                                    Padding="14"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource BorderRadius}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr ImportBible_VersesFound}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12" />
                                    <TextBlock x:Name="PreviewVerseCountText"
                                               Text="0"
                                               Margin="0,5,0,0"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Margin="14,0,0,0"
                                    Padding="14"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource BorderRadius}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr ImportBible_InvalidRows}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12" />
                                    <TextBlock x:Name="PreviewInvalidCountText"
                                               Text="0"
                                               Margin="0,5,0,0"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="{loc:Tr ImportBible_SampleVerses}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="2,0,2,12" />
                        <ItemsControl x:Name="SampleList"
                                      ItemsSource="{Binding Samples}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12"
                                            Padding="16"
                                            Background="{StaticResource CardBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource BorderRadius}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Reference}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Text}"
                                                       Margin="0,7,0,0"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="14"
                                                       LineHeight="20"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{loc:Tr ImportBible_InvalidRowsList}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="2,10,2,12" />
                        <Border x:Name="NoInvalidRowsPanel"
                                Padding="16"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource BorderRadius}">
                            <TextBlock Text="{loc:Tr ImportBible_NoInvalidRows}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="14" />
                        </Border>
                        <ItemsControl x:Name="InvalidRowsList"
                                      ItemsSource="{Binding InvalidRows}"
                                      Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="14"
                                            Background="{StaticResource CardBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource BorderRadius}">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="13"
                                                   LineHeight="18"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Margin="0,20,0,0"
                Padding="0,16,0,0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="118" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{loc:Tr ImportBible_Footer}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        Content="{loc:Tr Common_Preview}"
                        Click="Preview_Click" />
                <Button x:Name="StartImportButton"
                        Grid.Column="3"
                        Content="{loc:Tr ImportBible_StartImport}"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="StartImport_Click" />
                <Button Grid.Column="5"
                        Content="{loc:Tr Common_Cancel}"
                        Click="Cancel_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
