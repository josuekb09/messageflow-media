<Window x:Class="MessageFlow.App.ImportBibleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Bible"
        Height="660"
        Width="760"
        MinHeight="560"
        MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Import Bible"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="Local CSV only. MessageFlow does not download Bible files automatically."
                       Margin="0,6,0,18"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="13"
                       TextWrapping="Wrap" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Translation Name"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12" />
                <TextBox x:Name="TranslationNameBox"
                         Grid.Row="1"
                         Text="King James Version"
                         Margin="0,6,0,0" />

                <TextBlock Grid.Column="2"
                           Text="Abbreviation"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12" />
                <TextBox x:Name="AbbreviationBox"
                         Grid.Row="1"
                         Grid.Column="2"
                         Text="KJV"
                         Margin="0,6,0,0" />

                <TextBlock Grid.Column="4"
                           Text="Language"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12" />
                <TextBox x:Name="LanguageBox"
                         Grid.Row="1"
                         Grid.Column="4"
                         Text="English"
                         Margin="0,6,0,0" />
            </Grid>

            <TextBlock Text="Description"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,14,0,6" />
            <TextBox x:Name="DescriptionBox"
                     Text="King James Version local CSV import."
                     MinHeight="32" />

            <TextBlock Text="CSV File"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,14,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilePathBox"
                         VerticalContentAlignment="Center" />
                <Button Grid.Column="2"
                        Content="Browse"
                        Click="Browse_Click" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,18"
                Padding="16"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <TextBlock Text="Preview"
                               FontSize="17"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Left" />
                    <TextBlock x:Name="PreviewStatusText"
                               Text="Choose a CSV file and click Preview."
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <Grid Grid.Row="1"
                      Margin="0,14,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Translation"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" />
                        <TextBlock x:Name="PreviewTranslationText"
                                   Text="-"
                                   Margin="0,4,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Verses Found"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" />
                        <TextBlock x:Name="PreviewVerseCountText"
                                   Text="0"
                                   Margin="0,4,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Invalid Rows"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" />
                        <TextBlock x:Name="PreviewInvalidCountText"
                                   Text="0"
                                   Margin="0,4,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="First 10 sample verses"
                              Padding="8">
                        <ListBox x:Name="SampleList"
                                 ItemsSource="{Binding Samples}"
                                 DisplayMemberPath="DisplayText" />
                    </GroupBox>

                    <GroupBox Grid.Column="2"
                              Header="Invalid rows"
                              Padding="8">
                        <ListBox x:Name="InvalidRowsList"
                                 ItemsSource="{Binding InvalidRows}" />
                    </GroupBox>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Preview"
                    Click="Preview_Click" />
            <Button x:Name="StartImportButton"
                    Grid.Column="3"
                    Content="Start Import"
                    IsEnabled="False"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="StartImport_Click" />
            <Button Grid.Column="5"
                    Content="Cancel"
                    Click="Cancel_Click" />
        </Grid>
    </Grid>
</Window>
