<Window x:Class="MessageFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MessageFlow"
        Height="820"
        Width="1180"
        MinHeight="620"
        MinWidth="1080"
        WindowState="Maximized"
        Background="{StaticResource WindowBackgroundBrush}"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding ProjectCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding ProjectCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}" />
        <KeyBinding Key="Right" Command="{Binding NextParagraphCommand}" />
        <KeyBinding Key="Left" Command="{Binding PreviousParagraphCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="22,18"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="MessageFlow"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Margin="0,0,24,8"
                           VerticalAlignment="Center" />

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Orientation="Horizontal">
                <TextBox x:Name="SearchBox"
                         Margin="0,0,12,8"
                         MinWidth="220"
                         Width="300"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search sermons by title, code, phrase, or paragraph number"
                         VerticalContentAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBibleMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <ComboBox Grid.Column="2"
                          Margin="0,0,12,8"
                          ItemsSource="{Binding AuthorFilters}"
                          SelectedItem="{Binding SelectedAuthor}"
                          DisplayMemberPath="Label"
                          TextSearch.TextPath="Label"
                          MinWidth="140"
                          Width="132"
                          VerticalContentAlignment="Center">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBibleMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <ComboBox Grid.Column="3"
                          Margin="0,0,12,8"
                          ItemsSource="{Binding SourceFilters}"
                          SelectedItem="{Binding SelectedSourceFilter}"
                          DisplayMemberPath="Label"
                          TextSearch.TextPath="Label"
                          MinWidth="140"
                          Width="132"
                          VerticalContentAlignment="Center">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBibleMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <ComboBox Grid.Column="4"
                          Margin="0,0,12,8"
                          ItemsSource="{Binding YearFilters}"
                          SelectedItem="{Binding SelectedYear}"
                          DisplayMemberPath="Label"
                          TextSearch.TextPath="Label"
                          MinWidth="92"
                          Width="88"
                          VerticalContentAlignment="Center">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBibleMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <ComboBox Grid.Column="5"
                          Margin="0,0,0,8"
                          ItemsSource="{Binding ProjectionFontSizes}"
                          SelectedItem="{Binding SelectedProjectionFontSize}"
                          DisplayMemberPath="Label"
                          TextSearch.TextPath="Label"
                          MinWidth="150"
                          Width="132"
                          ToolTip="Projection font size"
                          VerticalContentAlignment="Center" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*" MinWidth="260" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.45*" MinWidth="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.05*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource BorderRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="16,14,16,10">
                        <TextBlock Text="Library"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding LibraryCountText}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   HorizontalAlignment="Right" />
                    </DockPanel>

                    <TabControl x:Name="LibraryTabs"
                                Grid.Row="1"
                                Margin="10,0,10,10"
                                SelectionChanged="LibraryTabs_SelectionChanged">
                        <TabItem Header="Search">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Search sermons by title, code, phrase, or paragraph number."
                                           Margin="4,0,4,12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap" />

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding SermonResults}"
                                         SelectedItem="{Binding SelectedSermon}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="{StaticResource CardPadding}"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource BorderRadius}">
                                                 <Grid>
                                                     <Grid.RowDefinitions>
                                                         <RowDefinition Height="Auto" />
                                                         <RowDefinition Height="Auto" />
                                                         <RowDefinition Height="Auto" />
                                                     </Grid.RowDefinitions>
                                                     <TextBlock Text="{Binding Title}"
                                                                FontSize="15"
                                                                FontWeight="SemiBold"
                                                                TextWrapping="Wrap" />
                                                     <TextBlock Grid.Row="1"
                                                                Margin="0,7,0,0"
                                                                Text="{Binding ContentTypeDisplay}"
                                                                Foreground="{StaticResource AccentBrush}"
                                                                FontSize="13"
                                                                FontWeight="SemiBold" />
                                                     <TextBlock Grid.Row="2"
                                                                Margin="0,6,0,0"
                                                                Text="{Binding MetaLine}"
                                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                                FontSize="13"
                                                                TextWrapping="Wrap" />
                                                 </Grid>
                                             </Border>
                                         </DataTemplate>
                                     </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="BibleTab"
                                 Header="Bible">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Search by book, chapter, verse, or keyword."
                                               Margin="4,0,4,8"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="13"
                                               TextWrapping="Wrap" />
                                    <TextBox x:Name="BibleSearchBox"
                                             Text="{Binding BibleSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Search Bible references or keywords"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <ListBox x:Name="BibleNavigationList"
                                             MinHeight="180"
                                             Margin="0,10,0,0"
                                             ItemsSource="{Binding BibleNavigationItems}"
                                             SelectedItem="{Binding SelectedBibleNavigationItem}"
                                             MouseLeftButtonUp="BibleNavigationList_MouseLeftButtonUp">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="{StaticResource CardPadding}"
                                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource BorderRadius}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding PrimaryText}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="1"
                                                                   Margin="0,6,0,0"
                                                                   Text="{Binding SecondaryText}"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Grid.Row="2"
                                                                   Margin="0,7,0,0"
                                                                   Text="{Binding PreviewText}"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                                   FontSize="13"
                                                                   LineHeight="18"
                                                                   MaxHeight="54"
                                                                   TextWrapping="Wrap" />
                                                   </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border Margin="12,22,12,0"
                                            Padding="16"
                                            Background="{StaticResource CardBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource BorderRadius}"
                                            IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsBibleAvailable}" Value="True" />
                                                            <Condition Binding="{Binding IsBibleResultsEmpty}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="Ready to search the Bible."
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Search by book, chapter, verse, or keyword."
                                                       Margin="0,6,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="2"
                                            Margin="0,10,0,0">
                                    <ComboBox ItemsSource="{Binding BibleTranslations}"
                                              SelectedItem="{Binding SelectedBibleTranslation}"
                                              DisplayMemberPath="DisplayName"
                                              TextSearch.TextPath="DisplayName"
                                              VerticalContentAlignment="Center" />
                                    <TextBlock Text="Bible is not available. Open Admin Tools if setup is needed."
                                               Margin="4,8,4,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="13"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBibleUnavailable}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Favorites">
                            <ScrollViewer Margin="0,10,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Padding="16"
                                            Background="{StaticResource CardBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource BorderRadius}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavoritesEmpty}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="No favorites yet."
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Save frequently used sermon paragraphs or Bible verses for quick access."
                                                       Margin="0,6,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFavorites}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBlock Text="Sermon Favorites"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="2,0,0,10" />

                                        <ListBox x:Name="FavoritesList"
                                                 ItemsSource="{Binding FavoriteParagraphs}"
                                                 SelectedItem="{Binding SelectedFavoriteParagraph}"
                                                 MouseDoubleClick="FavoritesList_MouseDoubleClick">
                                            <ListBox.Style>
                                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSermonFavoritesEmpty}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="{StaticResource CardPadding}"
                                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource BorderRadius}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="{Binding SermonTitle}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Grid.Row="1"
                                                                       Margin="0,8,0,0"
                                                                       Text="{Binding Meta}"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Grid.Row="2"
                                                                       Margin="0,8,0,0"
                                                                       Text="{Binding ParagraphTextPreview}"
                                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                                       FontSize="13"
                                                                       LineHeight="18"
                                                                       MaxHeight="54"
                                                                       TextWrapping="Wrap" />
                                                            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                                                <Button Content="Project"
                                                                        MinHeight="36"
                                                                        Padding="10,6"
                                                                        FontSize="12"
                                                                        Command="{Binding DataContext.ProjectFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="Remove Favorite"
                                                                        Margin="0,8,0,0"
                                                                        MinHeight="36"
                                                                        Padding="10,6"
                                                                        FontSize="12"
                                                                        Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Border Padding="14"
                                                Margin="0,0,0,20"
                                                Background="{StaticResource CardBackgroundBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource BorderRadius}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSermonFavoritesEmpty}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="No sermon favorites yet."
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </Border>

                                        <TextBlock Text="Bible Favorites"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="2,4,0,10" />

                                        <ListBox x:Name="BibleFavoritesList"
                                                 ItemsSource="{Binding BibleFavoriteVerses}"
                                                 SelectedItem="{Binding SelectedBibleFavoriteVerse}"
                                                 MouseDoubleClick="BibleFavoritesList_MouseDoubleClick">
                                            <ListBox.Style>
                                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBibleFavoritesEmpty}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="{StaticResource CardPadding}"
                                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource BorderRadius}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="{Binding DisplayLine}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Grid.Row="1"
                                                                       Margin="0,8,0,0"
                                                                       Text="{Binding MetaLine}"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Grid.Row="2"
                                                                       Margin="0,8,0,0"
                                                                       Text="{Binding PreviewText}"
                                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                                       FontSize="13"
                                                                       LineHeight="18"
                                                                       MaxHeight="54"
                                                                       TextWrapping="Wrap" />
                                                            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                                                <Button Content="Project"
                                                                        MinHeight="36"
                                                                        Padding="10,6"
                                                                        FontSize="12"
                                                                        Command="{Binding DataContext.ProjectBibleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="Copy"
                                                                        Margin="0,8,0,0"
                                                                        MinHeight="36"
                                                                        Padding="10,6"
                                                                        FontSize="12"
                                                                        Command="{Binding DataContext.CopyBibleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="Remove Favorite"
                                                                        Margin="0,8,0,0"
                                                                        MinHeight="36"
                                                                        Padding="10,6"
                                                                        FontSize="12"
                                                                        Command="{Binding DataContext.RemoveBibleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Border Padding="14"
                                                Background="{StaticResource CardBackgroundBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource BorderRadius}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBibleFavoritesEmpty}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="No Bible favorites yet."
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="HistoryTab"
                                 Header="History">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="0,10,0,10">
                                    <TextBlock Text="Recent projections"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Left" />
                                    <Button Content="Clear History"
                                            Command="{Binding ClearHistoryCommand}"
                                            MinHeight="38"
                                            Padding="12,7"
                                            FontSize="13"
                                            HorizontalAlignment="Right" />
                                </DockPanel>

                                <ListBox x:Name="HistoryList"
                                         Grid.Row="1"
                                         ItemsSource="{Binding ProjectionHistoryItems}"
                                         SelectedItem="{Binding SelectedHistoryParagraph}"
                                         MouseDoubleClick="HistoryList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="{StaticResource CardPadding}"
                                                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource BorderRadius}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding SermonTitle}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <DockPanel Grid.Row="1" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding Meta}"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   DockPanel.Dock="Left" />
                                                        <TextBlock Text="{Binding SavedAtText}"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Right" />
                                                    </DockPanel>
                                                    <TextBlock Grid.Row="2"
                                                               Margin="0,7,0,0"
                                                               Text="{Binding ParagraphTextPreview}"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               FontSize="13"
                                                               LineHeight="18"
                                                               MaxHeight="54"
                                                               TextWrapping="Wrap" />
                                                    <Button Grid.Row="3"
                                                            Content="Project"
                                                            Margin="0,12,0,0"
                                                            MinHeight="36"
                                                            Padding="10,6"
                                                            FontSize="12"
                                                            Command="{Binding DataContext.ProjectHistoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Margin="12,22,12,0"
                                        Grid.Row="1"
                                        Padding="16"
                                        Background="{StaticResource CardBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource BorderRadius}"
                                        IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProjectionHistoryEmpty}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="No projection history yet."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="14"
                                               TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ShowsPreview="True"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource BorderRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="16,14,16,10">
                        <TextBlock Text="{Binding CenterPanelTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <ListBox Grid.Row="1"
                             Margin="10,0,10,10"
                             ItemsSource="{Binding ParagraphResults}"
                             SelectedItem="{Binding SelectedParagraph}">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBibleMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ParagraphCard"
                                        Padding="0"
                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource BorderRadius}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="SelectedParagraphMarker"
                                                Grid.Column="0"
                                                Background="{StaticResource AccentBrush}"
                                                Opacity="0" />

                                        <Grid Grid.Column="1"
                                              Margin="14">
                                             <Grid.RowDefinitions>
                                                 <RowDefinition Height="Auto" />
                                                 <RowDefinition Height="Auto" />
                                                 <RowDefinition Height="Auto" />
                                             </Grid.RowDefinitions>
                                            <DockPanel>
                                                <TextBlock Text="{Binding ParagraphNumber, StringFormat=Paragraph {0}}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding PageNumber, StringFormat=Page {0}}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="13"
                                                           HorizontalAlignment="Right" />
                                            </DockPanel>
                                             <TextBlock Grid.Row="1"
                                                        Margin="0,8,0,0"
                                                        Text="{Binding MetadataLine}"
                                                        Foreground="{StaticResource MutedTextBrush}"
                                                        FontSize="13"
                                                        TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2"
                                                       Margin="0,7,0,0"
                                                       Text="{Binding ParagraphTextPreview}"
                                                       FontSize="16"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="22"
                                                       MaxHeight="74" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                 Value="True">
                                        <Setter TargetName="SelectedParagraphMarker"
                                                Property="Opacity"
                                                Value="1" />
                                        <Setter TargetName="ParagraphCard"
                                                Property="BorderThickness"
                                                Value="2" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ScrollViewer Grid.Row="1"
                                  Margin="20,8,20,20"
                                  VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBibleMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding PreviewHeader}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PreviewMeta}"
                                       Margin="0,8,0,20"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="15"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PreviewText}"
                                       FontSize="30"
                                       LineHeight="42"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            Margin="24"
                            Padding="22"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource BorderRadius}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsNotBibleMode}" Value="True" />
                                            <Condition Binding="{Binding IsParagraphResultsEmpty}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Ready to search sermons."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="16"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ShowsPreview="True"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="4"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource BorderRadius}">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding PreviewHeader}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PreviewMeta}"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="14"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,18,0,20"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding PreviewText}"
                                   FontSize="22"
                                   LineHeight="32"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding RightPanelTitle}"
                                   Margin="2,0,2,12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Project"
                                    Command="{Binding ProjectCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Grid.Column="2"
                                    Content="Copy"
                                    Command="{Binding CopyCommand}" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding PreviousParagraphCommand}">
                                <TextBlock Text="{Binding PreviousButtonText}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding NextParagraphCommand}">
                                <TextBlock Text="{Binding NextButtonText}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Button>
                        </Grid>

                        <Button Margin="0,10,0,0"
                                Content="{Binding FavoriteButtonText}"
                                Command="{Binding ToggleFavoriteCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="18,8"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1"
                           Margin="18,0,0,0"
                           Text="{Binding ProjectionStatusText}"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="13"
                           FontWeight="SemiBold" />

                <Button Grid.Column="2"
                        Content="Admin"
                        Margin="18,0,0,0"
                        MinHeight="30"
                        Padding="12,5"
                        FontSize="12"
                        Click="Admin_Click"
                        ToolTip="Open Admin Tools (Ctrl+Shift+A)" />
            </Grid>
        </Border>
    </Grid>
</Window>
