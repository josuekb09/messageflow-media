<Window x:Class="MessageFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MessageFlow"
        Height="820"
        Width="1380"
        MinHeight="680"
        MinWidth="1120"
        Background="{StaticResource WindowBackgroundBrush}"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding ProjectCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding ProjectCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}" />
        <KeyBinding Key="Right" Command="{Binding NextParagraphCommand}" />
        <KeyBinding Key="Left" Command="{Binding PreviousParagraphCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="22,18"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="MessageFlow"
                           FontSize="28"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Margin="0,0,14,0"
                         MinWidth="260"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search sermons and paragraphs"
                         VerticalContentAlignment="Center" />

                <ComboBox Grid.Column="2"
                          Margin="0,0,14,0"
                          ItemsSource="{Binding AuthorFilters}"
                          SelectedItem="{Binding SelectedAuthor}"
                          DisplayMemberPath="Label"
                          TextSearch.TextPath="Label"
                          MinWidth="220"
                          VerticalContentAlignment="Center" />

                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding YearFilters}"
                          SelectedItem="{Binding SelectedYear}"
                          DisplayMemberPath="Label"
                          TextSearch.TextPath="Label"
                          MinWidth="130"
                          VerticalContentAlignment="Center" />

                <ComboBox Grid.Column="4"
                          Margin="14,0,0,0"
                          ItemsSource="{Binding ProjectionFontSizes}"
                          SelectedItem="{Binding SelectedProjectionFontSize}"
                          DisplayMemberPath="Label"
                          TextSearch.TextPath="Label"
                          MinWidth="150"
                          ToolTip="Projection font size"
                          VerticalContentAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="16,14,16,10">
                        <TextBlock Text="Library"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding ResultCount, StringFormat={}{0} paragraphs}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   HorizontalAlignment="Right" />
                    </DockPanel>

                    <TabControl x:Name="LibraryTabs"
                                Grid.Row="1"
                                Margin="10,0,10,10"
                                SelectionChanged="LibraryTabs_SelectionChanged">
                        <TabItem Header="Search">
                            <ListBox Margin="0,10,0,0"
                                     ItemsSource="{Binding SermonResults}"
                                     SelectedItem="{Binding SelectedSermon}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding SermonCode}"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               FontSize="13"
                                                               DockPanel.Dock="Left" />
                                                    <TextBlock Text="{Binding Year}"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontSize="13"
                                                               HorizontalAlignment="Right" />
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>

                        <TabItem Header="Favorites">
                            <ListBox x:Name="FavoritesList"
                                     Margin="0,10,0,0"
                                     ItemsSource="{Binding FavoriteParagraphs}"
                                     SelectedItem="{Binding SelectedFavoriteParagraph}"
                                     MouseDoubleClick="FavoritesList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding SermonTitle}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="1"
                                                           Margin="0,6,0,0"
                                                           Text="{Binding Meta}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="2"
                                                           Margin="0,7,0,0"
                                                           Text="{Binding ParagraphTextPreview}"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           FontSize="13"
                                                           LineHeight="18"
                                                           MaxHeight="54"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>

                        <TabItem x:Name="HistoryTab"
                                 Header="History">
                            <Grid>
                                <ListBox x:Name="HistoryList"
                                         Margin="0,10,0,0"
                                         ItemsSource="{Binding ProjectionHistoryItems}"
                                         SelectedItem="{Binding SelectedHistoryParagraph}"
                                         MouseDoubleClick="HistoryList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12"
                                                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                    BorderThickness="1"
                                                    CornerRadius="5">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding SermonTitle}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <DockPanel Grid.Row="1" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding Meta}"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   DockPanel.Dock="Left" />
                                                        <TextBlock Text="{Binding SavedAtText}"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Right" />
                                                    </DockPanel>
                                                    <TextBlock Grid.Row="2"
                                                               Margin="0,7,0,0"
                                                               Text="{Binding ParagraphTextPreview}"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               FontSize="13"
                                                               LineHeight="18"
                                                               MaxHeight="54"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="No projection history yet."
                                           Margin="12,22,12,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProjectionHistoryEmpty}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Tools">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Database"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="4,4,4,10" />
                                <Button Content="Backup Database"
                                        Command="{Binding BackupDatabaseCommand}" />
                                <Button Content="Restore Database"
                                        Margin="0,10,0,0"
                                        Command="{Binding RestoreDatabaseCommand}" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="16,14,16,10">
                        <TextBlock Text="Paragraphs"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <ListBox Grid.Row="1"
                             Margin="10,0,10,10"
                             ItemsSource="{Binding ParagraphResults}"
                             SelectedItem="{Binding SelectedParagraph}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ParagraphCard"
                                        Padding="0"
                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="SelectedParagraphMarker"
                                                Grid.Column="0"
                                                Background="{StaticResource AccentBrush}"
                                                Opacity="0" />

                                        <Grid Grid.Column="1"
                                              Margin="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DockPanel>
                                                <TextBlock Text="{Binding ParagraphNumber, StringFormat=Paragraph {0}}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding PageNumber, StringFormat=Page {0}}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="13"
                                                           HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,8,0,0"
                                                       Text="{Binding ParagraphTextPreview}"
                                                       FontSize="16"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="22"
                                                       MaxHeight="74" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                 Value="True">
                                        <Setter TargetName="SelectedParagraphMarker"
                                                Property="Opacity"
                                                Value="1" />
                                        <Setter TargetName="ParagraphCard"
                                                Property="BorderThickness"
                                                Value="2" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="4"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding SelectedParagraphHeader}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedParagraphMeta}"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="14"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,18,0,18"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding SelectedParagraphText}"
                                   FontSize="22"
                                   LineHeight="32"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Project"
                                    Command="{Binding ProjectCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Grid.Column="2"
                                    Content="Copy"
                                    Command="{Binding CopyCommand}" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Previous"
                                    Command="{Binding PreviousParagraphCommand}" />
                            <Button Grid.Column="2"
                                    Content="Next"
                                    Command="{Binding NextParagraphCommand}" />
                        </Grid>

                        <Button Margin="0,10,0,0"
                                Content="{Binding FavoriteButtonText}"
                                Command="{Binding ToggleFavoriteCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="18,8"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1"
                           Margin="18,0,0,0"
                           Text="{Binding ProjectionStatusText}"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="13"
                           FontWeight="SemiBold" />
            </Grid>
        </Border>
    </Grid>
</Window>
