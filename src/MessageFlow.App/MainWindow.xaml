<Window x:Class="MessageFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MessageFlow.App.Controls"
        xmlns:loc="clr-namespace:MessageFlow.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MessageFlow"
        Icon="pack://application:,,,/Assets/Brand/messageflow-app-icon-1024.png"
        Height="720"
        Width="1180"
        MinHeight="500"
        MinWidth="980"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ShowActivated="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Library navigation rail. One button per LibraryTabs TabItem; the active
             button carries a 2px accent bar on its leading edge (square on that side)
             and switches its glyph from MutedTextBrush to AccentBrush. Glyph codepoints
             are verified present in both Segoe Fluent Icons and Segoe MDL2 Assets, so
             the fallback renders rather than showing empty boxes. -->
        <Style x:Key="NavigationRailButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="AccentBar"
                                    Grid.Column="0"
                                    Background="Transparent"
                                    CornerRadius="0"
                                    Margin="0,6" />

                            <Border x:Name="Wash"
                                    Grid.Column="1"
                                    Background="Transparent"
                                    CornerRadius="8"
                                    Margin="4,4,6,4" />

                            <ContentPresenter Grid.Column="1"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Wash" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Wash" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sermon result cards: the selected card keeps the plain card background and
             is marked with a 3px accent bar on its leading edge instead of a solid fill
             wash. Scoped to the sermon list; every other list keeps the global style. -->
        <Style x:Key="SermonCardItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource BorderRadius}"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="AccentEdge"
                                        Grid.Column="0"
                                        Background="Transparent"
                                        CornerRadius="0" />

                                <Border x:Name="HoverWash"
                                        Grid.Column="1"
                                        Background="{DynamicResource AccentBrush}"
                                        Opacity="0" />

                                <ContentPresenter Grid.Column="1"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverWash" Property="Opacity" Value="0.06" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="AccentEdge" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AuthorFilterPillStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource GhostButtonHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding ProjectCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="20,12"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Border.Resources>
                <Style x:Key="TopToolbarTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Padding" Value="12,7" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
                <Style x:Key="TopToolbarComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
            </Border.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="0,0,18,4"
                            VerticalAlignment="Center">
                    <!-- Inline mark only. This follows AccentBrush, so it reads sky blue in
                         the dark theme and gold in the light one. The app's fixed identity -
                         window/taskbar icon, the .exe icon, the shortcut and the installer -
                         stays permanently gold and is unaffected by this. -->
                    <Path Data="M5.7,19.7 L5.7,7.7 L14,15.9 L22.3,7.7 L22.3,19.7"
                          Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="3.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="28"
                          Height="28"
                          Stretch="None"
                          Margin="0,0,9,0" />
                    <TextBlock Text="MessageFlow"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Orientation="Horizontal">
                <TextBox x:Name="SearchBox"
                          Margin="0,0,10,6"
                          MinWidth="170"
                          Width="240"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{loc:Tr Toolbar_SearchSermonsTooltip}"
                         VerticalContentAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource TopToolbarTextBoxStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBibleMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSongsMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- The author filter is hidden: every content source belongs to exactly one
                     author, so it offered the same choice as the Sources filter beside it.
                     The binding stays so Admin diagnostics keep working. -->
                <ComboBox Grid.Column="2"
                          Margin="0,0,10,6"
                          Visibility="Collapsed"
                          ItemsSource="{Binding AuthorFilters}"
                          SelectedItem="{Binding SelectedAuthor}"
                          DisplayMemberPath="Label"
                          TextSearch.TextPath="Label"
                          MinWidth="154"
                          MaxWidth="240"
                          VerticalContentAlignment="Center" />

                <!-- The Source and Year filters used to be repeated here. They are now shown only
                     in the Sermons tab's Library panel (source pills and the Year dropdown), which
                     binds the same SelectedSourceFilter and SelectedYear state. Two controls for
                     one filter left the operator unsure which one was in effect. -->

                <ComboBox Grid.Column="5"
                          Style="{StaticResource TopToolbarComboBoxStyle}"
                          Margin="0,0,8,6"
                          ItemsSource="{Binding ProjectionFontSizes}"
                          SelectedItem="{Binding SelectedProjectionFontSize}"
                          DisplayMemberPath="Label"
                          TextSearch.TextPath="Label"
                          MinWidth="124"
                          Width="132"
                          ToolTip="{loc:Tr Toolbar_FontSizeTooltip}"
                          VerticalContentAlignment="Center" />

                <Button Content="A-"
                        Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding DecreaseProjectionTextSizeCommand}"
                        Width="40"
                        MinHeight="40"
                        Margin="0,0,6,6"
                        Padding="0"
                        FontSize="14"
                        ToolTip="{loc:Tr Toolbar_DecreaseTextTooltip}" />

                <Button Content="{loc:Tr Toolbar_Fit}"
                        Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding ResetProjectionTextSizeCommand}"
                        MinWidth="56"
                        MinHeight="40"
                        Margin="0,0,6,6"
                        Padding="10,0"
                        FontSize="13"
                        ToolTip="{loc:Tr Toolbar_FitTextTooltip}" />

                <Button Content="A+"
                        Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding IncreaseProjectionTextSizeCommand}"
                        Width="40"
                        MinHeight="40"
                        Margin="0,0,8,6"
                        Padding="0"
                        FontSize="14"
                        ToolTip="{loc:Tr Toolbar_IncreaseTextTooltip}" />

                <ComboBox Style="{StaticResource TopToolbarComboBoxStyle}"
                          Margin="0,0,10,6"
                          ItemsSource="{Binding AvailableUiLanguages}"
                          SelectedItem="{Binding SelectedUiLanguage}"
                          DisplayMemberPath="NativeName"
                          MinWidth="118"
                          MaxWidth="148"
                          ToolTip="{loc:Tr Lang_SelectorTooltip}"
                          VerticalContentAlignment="Center" />

                <CheckBox Content="{loc:Tr Theme_Light}"
                          IsChecked="{Binding IsLightTheme}"
                          Margin="0,0,0,6"
                          MinHeight="40"
                          VerticalAlignment="Center"
                          ToolTip="{loc:Tr Theme_LightTooltip}" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="18"
              ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Library navigation rail, full height of the workspace and flush against
                 the Library panel it drives. Buttons are wired to their TabItem in
                 code-behind, which reuses LibraryTabs_SelectionChanged for the switch. -->
            <Border Grid.Column="0"
                    Width="60"
                    Margin="0,0,10,0"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource BorderRadius}">
                <StackPanel Margin="0,10" VerticalAlignment="Top">
                    <ToggleButton x:Name="NavSermonsButton"
                                  Style="{StaticResource NavigationRailButtonStyle}"
                                  AutomationProperties.Name="{loc:Tr Nav_Sermons}"
                                  ToolTip="{loc:Tr Nav_Sermons}"
                                  Checked="NavigationRailButton_Checked">
                        <Path Data="M4,5 L4,19 L20,19 L20,5 Z M12,5 L12,19"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              Width="24"
                              Height="24"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </ToggleButton>
                    <!-- Segoe Fluent Icons has no cross glyph, so the Bible icon is drawn
                         here instead. Stroke follows the button's Foreground, which the
                         shared style's IsChecked trigger already swaps between
                         MutedTextBrush and AccentBrush, so this button keeps exactly the
                         same active-state behaviour as the four glyph buttons. Round caps
                         match the open-stroke styling of the MessageFlow mark. -->
                    <ToggleButton x:Name="NavBibleButton"
                                  Style="{StaticResource NavigationRailButtonStyle}"
                                  AutomationProperties.Name="{loc:Tr Nav_Bible}"
                                  ToolTip="{loc:Tr Nav_Bible}"
                                  Checked="NavigationRailButton_Checked">
                        <Path Data="M 12,3 L 12,21 M 6,9 L 18,9"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="2.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="24"
                              Height="24"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </ToggleButton>
                    <ToggleButton x:Name="NavSongsButton"
                                  Style="{StaticResource NavigationRailButtonStyle}"
                                  AutomationProperties.Name="{loc:Tr Nav_Songs}"
                                  ToolTip="{loc:Tr Nav_Songs}"
                                  Checked="NavigationRailButton_Checked">
                        <Canvas Width="24" Height="24">
                            <Path Data="M15,4 L15,16 M15,4 C18,5 18,8 15,9"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Ellipse Canvas.Left="9"
                                     Canvas.Top="14"
                                     Width="7"
                                     Height="5"
                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        </Canvas>
                    </ToggleButton>
                    <ToggleButton x:Name="NavFavoritesButton"
                                  Style="{StaticResource NavigationRailButtonStyle}"
                                  AutomationProperties.Name="{loc:Tr Nav_Favorites}"
                                  ToolTip="{loc:Tr Nav_Favorites}"
                                  Checked="NavigationRailButton_Checked">
                        <Path Data="M12,2 L14.6,9.5 L22,9.8 L16.2,14.6 L18.2,22 L12,17.6 L5.8,22 L7.8,14.6 L2,9.8 L9.4,9.5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              Width="24"
                              Height="24"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </ToggleButton>
                    <ToggleButton x:Name="NavHistoryButton"
                                  Style="{StaticResource NavigationRailButtonStyle}"
                                  AutomationProperties.Name="{loc:Tr Nav_History}"
                                  ToolTip="{loc:Tr Nav_History}"
                                  Checked="NavigationRailButton_Checked">
                        <Canvas Width="24" Height="24">
                            <Ellipse Canvas.Left="4"
                                     Canvas.Top="4"
                                     Width="16"
                                     Height="16"
                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                     StrokeThickness="2"
                                     Fill="Transparent" />
                            <Path Data="M12,12 L12,7 M12,12 L16,13"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </ToggleButton>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*" MinWidth="380" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1.35*" MinWidth="270" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1.05*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource BorderRadius}"
                    ClipToBounds="True">
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,16,20,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Tr Nav_Library}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LibraryCountText}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="13"
                                   Margin="12,0,0,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <TabControl x:Name="LibraryTabs"
                                Grid.Row="1"
                                Margin="10,0,10,10"
                                MinHeight="0"
                                ClipToBounds="True"
                                SelectionChanged="LibraryTabs_SelectionChanged">
                        <TabControl.Resources>
                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                <Setter Property="Padding" Value="8,7" />
                                <Setter Property="FontSize" Value="12" />
                            </Style>
                        </TabControl.Resources>
                        <TabItem x:Name="SermonsTab"
                                 Header="{loc:Tr Nav_Sermons}">
                            <Grid Margin="0,10,0,0"
                                  MinHeight="0"
                                  ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="4,0,4,10">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSermonReadingMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Library Selector Segmented Pills.
                                         These pick the content source, which is the library the
                                         search is scoped to. Each library maps to exactly one
                                         author, so a separate author filter would repeat this. -->
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="3"
                                            Margin="0,0,0,8">
                                        <UniformGrid Rows="1" Columns="3">
                                            <RadioButton Content="{loc:Tr Filter_AllSources}"
                                                         GroupName="LibraryFilterPills"
                                                         IsChecked="{Binding IsAllSourcesSelected, Mode=OneWay}"
                                                         Command="{Binding SelectAllSourcesCommand}"
                                                         Style="{StaticResource AuthorFilterPillStyle}" />
                                            <RadioButton Content="{loc:Tr Author_Branham}"
                                                         GroupName="LibraryFilterPills"
                                                         IsChecked="{Binding IsBranhamSourceSelected, Mode=OneWay}"
                                                         Command="{Binding SelectBranhamSourceCommand}"
                                                         Visibility="{Binding HasBranhamLibraryForCurrentLanguage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                         Style="{StaticResource AuthorFilterPillStyle}" />
                                            <RadioButton Content="{loc:Tr Author_Frank}"
                                                         GroupName="LibraryFilterPills"
                                                         IsChecked="{Binding IsFrankSourceSelected, Mode=OneWay}"
                                                         Command="{Binding SelectFrankSourceCommand}"
                                                         Visibility="{Binding HasFrankLibraryForCurrentLanguage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                         Style="{StaticResource AuthorFilterPillStyle}" />
                                        </UniformGrid>
                                    </Border>

                                    <!-- Quick Year Filter & Search Hint -->
                                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                        <TextBlock Text="{loc:Tr Filter_YearLabel}"
                                                   VerticalAlignment="Center"
                                                   Margin="2,0,8,0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <ComboBox ItemsSource="{Binding YearFilters}"
                                                  SelectedItem="{Binding SelectedYear}"
                                                  DisplayMemberPath="Label"
                                                  TextSearch.TextPath="Label"
                                                  MinHeight="28"
                                                  MinWidth="110"
                                                  MaxWidth="180"
                                                  FontSize="12"
                                                  VerticalContentAlignment="Center"
                                                  HorizontalAlignment="Left" />
                                    </DockPanel>

                                    <TextBlock Text="{loc:Tr Sermon_SearchHint}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Browsing a whole library lists every document (over 1200 for
                                     Brother Branham), so this list must virtualize. The app-wide
                                     ListBox style sets CanContentScroll="False", which measures the
                                     panel with infinite height and realizes every card. These four
                                     attached properties override that for this list only; every
                                     other list in the app stays on the global style because none of
                                     them exceeds 200 items. ScrollUnit="Pixel" keeps the smooth
                                     per-pixel scrolling (and GentleScroll's pixel wheel step)
                                     that CanContentScroll="False" was providing. -->
                                <ListBox Grid.Row="1"
                                         MinHeight="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Pixel"
                                         ItemsSource="{Binding SermonResults}"
                                         SelectedItem="{Binding SelectedSermon}"
                                         ItemContainerStyle="{StaticResource SermonCardItemStyle}">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSermonReadingMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="{StaticResource CardPadding}"
                                                MinHeight="92"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource BorderRadius}">
                                                 <Grid>
                                                     <Grid.RowDefinitions>
                                                         <RowDefinition Height="Auto" />
                                                         <RowDefinition Height="Auto" />
                                                         <RowDefinition Height="Auto" />
                                                         <RowDefinition Height="Auto" />
                                                         <RowDefinition Height="Auto" />
                                                     </Grid.RowDefinitions>
                                                     <!-- Document-type chip, above the title. -->
                                                     <Border HorizontalAlignment="Left"
                                                             Margin="0,0,0,8"
                                                             Padding="8,2"
                                                             CornerRadius="9"
                                                             Background="{DynamicResource HighlightBackgroundBrush}">
                                                         <TextBlock Text="{Binding ContentTypeDisplay}"
                                                                    Foreground="{DynamicResource HighlightForegroundBrush}"
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold" />
                                                     </Border>
                                                     <TextBlock Grid.Row="1"
                                                                Text="{Binding Title}"
                                                                FontSize="16"
                                                                FontWeight="SemiBold"
                                                                TextWrapping="Wrap"
                                                                LineHeight="21" />
                                                     <TextBlock Grid.Row="2"
                                                                Margin="0,7,0,0"
                                                                Text="{Binding MetaLine}"
                                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                                FontSize="13"
                                                                LineHeight="19"
                                                                TextWrapping="Wrap" />
                                                     <controls:HighlightedTextBlock Grid.Row="3"
                                                                                    Margin="0,7,0,0"
                                                                                    SourceText="{Binding BestMatchLine}"
                                                                                    HighlightQuery="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                                    Foreground="{DynamicResource MutedTextBrush}"
                                                                                    FontSize="12"
                                                                                    LineHeight="17"
                                                                                    TextWrapping="Wrap" />
                                                     <Button Grid.Row="4"
                                                             Margin="0,10,0,0"
                                                             Content="{Binding OpenButtonText}"
                                                             ToolTip="{loc:Tr Sermon_OpenTooltip}"
                                                             Command="{Binding DataContext.OpenSermonCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                             CommandParameter="{Binding}" />
                                                 </Grid>
                                             </Border>
                                         </DataTemplate>
                                     </ListBox.ItemTemplate>
                                 </ListBox>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="BibleTab"
                                 Header="{loc:Tr Nav_Bible}">
                            <Grid Margin="0,10,0,0"
                                  MinHeight="0"
                                  ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <DockPanel Margin="4,0,4,8"
                                               LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding BibleTranslations}"
                                                  SelectedItem="{Binding SelectedBibleTranslation}"
                                                  DisplayMemberPath="DisplayName"
                                                  TextSearch.TextPath="DisplayName"
                                                  MinWidth="142"
                                                  MaxWidth="220"
                                                  Margin="12,0,0,0"
                                                  Padding="10,6"
                                                  FontSize="13"
                                                  MinHeight="38"
                                                  VerticalContentAlignment="Center">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMultipleBibleTranslations}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>

                                        <Border DockPanel.Dock="Right"
                                                Margin="12,0,0,0"
                                                Padding="10,6"
                                                Background="{DynamicResource CardBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSingleBibleTranslation}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding SelectedBibleVersionShortDisplay}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                        </Border>

                                        <TextBlock Text="{loc:Tr Bible_SearchHint}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </DockPanel>
                                    <TextBox x:Name="BibleSearchBox"
                                             Text="{Binding BibleSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{loc:Tr Bible_SearchTooltip}"
                                             VerticalContentAlignment="Center" />
                                    <TextBlock Text="{loc:Tr Bible_NotAvailable}"
                                               Margin="4,8,4,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="13"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBibleUnavailable}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <ListBox x:Name="BibleNavigationList"
                                             MinHeight="0"
                                             Margin="0,12,0,12"
                                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemsSource="{Binding BibleNavigationItems}"
                                             SelectedItem="{Binding SelectedBibleNavigationItem}"
                                             MouseLeftButtonUp="BibleNavigationList_MouseLeftButtonUp">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="18,15"
                                                        MinHeight="96"
                                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource BorderRadius}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding PrimaryText}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   LineHeight="22" />
                                                        <TextBlock Grid.Row="1"
                                                                   Margin="0,7,0,0"
                                                                   Text="{Binding SecondaryText}"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Grid.Row="2"
                                                                   Margin="0,9,0,0"
                                                                   Text="{Binding PreviewText}"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   FontSize="14"
                                                                   LineHeight="21"
                                                                   MaxHeight="84"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border Margin="12,22,12,0"
                                            Padding="16"
                                            Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource BorderRadius}"
                                            IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsBibleAvailable}" Value="True" />
                                                            <Condition Binding="{Binding IsBibleResultsEmpty}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr Bible_ReadyToSearch}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{loc:Tr Bible_SearchHint}"
                                                       Margin="0,6,0,0"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                            </Grid>
                        </TabItem>

                        <TabItem x:Name="SongsTab"
                                 Header="{loc:Tr Nav_Songs}">
                            <Grid Margin="0,10,0,0"
                                  MinHeight="0"
                                  ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Song_SearchHint}"
                                               Margin="4,0,4,8"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="13"
                                               TextWrapping="Wrap" />
                                    <TextBox x:Name="SongSearchBox"
                                             Text="{Binding SongSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{loc:Tr Song_SearchTooltip}"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <ListBox MinHeight="0"
                                             Margin="0,12,0,12"
                                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemsSource="{Binding SongResults}"
                                             SelectedItem="{Binding SelectedSong}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="{StaticResource CardPadding}"
                                                        MinHeight="92"
                                                        ToolTip="{Binding TooltipText}"
                                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource BorderRadius}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   LineHeight="21" />
                                                        <TextBlock Grid.Row="1"
                                                                   Margin="0,8,0,0"
                                                                   Text="{Binding MetaLine}"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="2"
                                                                   Margin="0,7,0,0"
                                                                   Text="{Binding LyricSnippet}"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   FontSize="13"
                                                                   LineHeight="19"
                                                                   MaxHeight="76"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="3"
                                                                   Margin="0,8,0,0"
                                                                   Text="{Binding FileName}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border Margin="12,22,12,0"
                                            Padding="16"
                                            Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource BorderRadius}"
                                            IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSongResultsEmpty}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SongEmptyStateTitle}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SongEmptyStateDetail}"
                                                       Margin="0,6,0,0"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="FavoritesTab"
                                 Header="{loc:Tr Nav_Favorites}">
                            <ScrollViewer Margin="0,10,0,0"
                                          MinHeight="0"
                                          VerticalScrollBarVisibility="Visible"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Padding="16"
                                            Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource BorderRadius}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavoritesEmpty}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr Fav_None}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{loc:Tr Fav_NoneDetail}"
                                                       Margin="0,6,0,0"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFavorites}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBlock Text="{loc:Tr Fav_SermonSection}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="2,0,0,10" />

                                        <ListBox x:Name="FavoritesList"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemsSource="{Binding FavoriteParagraphs}"
                                                 SelectedItem="{Binding SelectedFavoriteParagraph}"
                                                 MouseDoubleClick="FavoritesList_MouseDoubleClick">
                                            <ListBox.Style>
                                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSermonFavoritesEmpty}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="{StaticResource CardPadding}"
                                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource BorderRadius}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="{Binding SermonTitle}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Grid.Row="1"
                                                                       Margin="0,8,0,0"
                                                                       Text="{Binding Meta}"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Grid.Row="2"
                                                                       Margin="0,8,0,0"
                                                                       Text="{Binding ParagraphTextPreview}"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                                       FontSize="13"
                                                                       LineHeight="18"
                                                                       MaxHeight="54"
                                                                       TextWrapping="Wrap" />
                                                            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                                                <Button Content="{loc:Tr Common_Project}"
                                                                        MinHeight="36"
                                                                        Padding="10,6"
                                                                        FontSize="12"
                                                                        Command="{Binding DataContext.ProjectFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="{loc:Tr Fav_Remove}"
                                                                        Margin="0,8,0,0"
                                                                        MinHeight="36"
                                                                        Padding="10,6"
                                                                        FontSize="12"
                                                                        Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Border Padding="14"
                                                Margin="0,0,0,20"
                                                Background="{DynamicResource CardBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource BorderRadius}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSermonFavoritesEmpty}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{loc:Tr Fav_NoSermonFavorites}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </Border>

                                        <TextBlock Text="{loc:Tr Fav_BibleSection}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="2,4,0,10" />

                                        <ListBox x:Name="BibleFavoritesList"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemsSource="{Binding BibleFavoriteVerses}"
                                                 SelectedItem="{Binding SelectedBibleFavoriteVerse}"
                                                 MouseDoubleClick="BibleFavoritesList_MouseDoubleClick">
                                            <ListBox.Style>
                                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBibleFavoritesEmpty}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="{StaticResource CardPadding}"
                                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource BorderRadius}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="{Binding DisplayLine}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Grid.Row="1"
                                                                       Margin="0,8,0,0"
                                                                       Text="{Binding MetaLine}"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Grid.Row="2"
                                                                       Margin="0,8,0,0"
                                                                       Text="{Binding PreviewText}"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                                       FontSize="13"
                                                                       LineHeight="18"
                                                                       MaxHeight="54"
                                                                       TextWrapping="Wrap" />
                                                            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                                                <Button Content="{loc:Tr Common_Project}"
                                                                        MinHeight="36"
                                                                        Padding="10,6"
                                                                        FontSize="12"
                                                                        Command="{Binding DataContext.ProjectBibleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="{loc:Tr Common_Copy}"
                                                                        Margin="0,8,0,0"
                                                                        MinHeight="36"
                                                                        Padding="10,6"
                                                                        FontSize="12"
                                                                        Command="{Binding DataContext.CopyBibleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="{loc:Tr Fav_Remove}"
                                                                        Margin="0,8,0,0"
                                                                        MinHeight="36"
                                                                        Padding="10,6"
                                                                        FontSize="12"
                                                                        Command="{Binding DataContext.RemoveBibleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Border Padding="14"
                                                Background="{DynamicResource CardBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource BorderRadius}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBibleFavoritesEmpty}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{loc:Tr Fav_NoBibleFavorites}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="HistoryTab"
                                 Header="{loc:Tr Nav_History}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="0,10,0,10">
                                    <TextBlock Text="{loc:Tr History_Recent}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Left" />
                                    <Button Content="{loc:Tr History_Clear}"
                                            Command="{Binding ClearHistoryCommand}"
                                            MinHeight="38"
                                            Padding="12,7"
                                            FontSize="13"
                                            HorizontalAlignment="Right" />
                                </DockPanel>

                                <ListBox x:Name="HistoryList"
                                         Grid.Row="1"
                                         MinHeight="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemsSource="{Binding ProjectionHistoryItems}"
                                         SelectedItem="{Binding SelectedHistoryParagraph}"
                                         MouseDoubleClick="HistoryList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="{StaticResource CardPadding}"
                                                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource BorderRadius}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding SermonTitle}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <DockPanel Grid.Row="1" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding Meta}"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   DockPanel.Dock="Left" />
                                                        <TextBlock Text="{Binding SavedAtText}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Right" />
                                                    </DockPanel>
                                                    <TextBlock Grid.Row="2"
                                                               Margin="0,7,0,0"
                                                               Text="{Binding ParagraphTextPreview}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               FontSize="13"
                                                               LineHeight="18"
                                                               MaxHeight="54"
                                                               TextWrapping="Wrap" />
                                                    <Button Grid.Row="3"
                                                            Content="{loc:Tr Common_Project}"
                                                            Margin="0,12,0,0"
                                                            MinHeight="36"
                                                            Padding="10,6"
                                                            FontSize="12"
                                                            Command="{Binding DataContext.ProjectHistoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Margin="12,22,12,0"
                                        Grid.Row="1"
                                        Padding="16"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource BorderRadius}"
                                        IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProjectionHistoryEmpty}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{loc:Tr History_None}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="14"
                                               TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          Focusable="False"
                          ShowsPreview="True"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource BorderRadius}"
                    ClipToBounds="True">
                <Grid MinHeight="0"
                      ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,16,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Margin="0,0,10,0"
                                Padding="8,4"
                                Content="{loc:Tr Sermon_Back}"
                                ToolTip="{loc:Tr Sermon_BackTooltip}"
                                Command="{Binding BackToSermonSearchResultsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSermonReadingMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CenterPanelTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   ToolTip="{Binding CenterPanelTitle}" />
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,5,0,0"
                                   Text="{Binding StatusText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="13"
                                   HorizontalAlignment="Right"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <ListBox x:Name="ParagraphResultsList"
                             Grid.Row="1"
                             Margin="10,0,10,10"
                             MinHeight="0"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding ParagraphResults}"
                             SelectedItem="{Binding SelectedParagraph}"
                             SelectionChanged="ParagraphResultsList_SelectionChanged">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBibleMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSongsMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ParagraphCard"
                                        Padding="0"
                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource BorderRadius}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="SelectedParagraphMarker"
                                                Grid.Column="0"
                                                Background="{DynamicResource AccentBrush}"
                                                Opacity="0" />

                                        <Grid Grid.Column="1"
                                              Margin="16">
                                             <Grid.RowDefinitions>
                                                 <RowDefinition Height="Auto" />
                                                 <RowDefinition Height="Auto" />
                                                 <RowDefinition Height="Auto" />
                                             </Grid.RowDefinitions>
                                            <DockPanel>
                                                <TextBlock Text="{Binding ParagraphNumber, StringFormat=Paragraph {0}}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="15"
                                                           DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding PageNumber, StringFormat=Page {0}}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="13"
                                                           HorizontalAlignment="Right" />
                                            </DockPanel>
                                             <TextBlock Grid.Row="1"
                                                        Margin="0,8,0,0"
                                                        Text="{Binding MetadataLine}"
                                                        Foreground="{DynamicResource MutedTextBrush}"
                                                        FontSize="13"
                                                        TextWrapping="Wrap" />
                                            <controls:HighlightedTextBlock Grid.Row="2"
                                                                           Margin="0,9,0,0"
                                                                           SourceText="{Binding ParagraphTextPreview}"
                                                                           HighlightQuery="{Binding DataContext.SermonHighlightQuery, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                           FontSize="17"
                                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                                           TextWrapping="Wrap"
                                                                           LineHeight="24"
                                                                           MaxHeight="96" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                 Value="True">
                                        <Setter TargetName="SelectedParagraphMarker"
                                                Property="Opacity"
                                                Value="1" />
                                        <Setter TargetName="ParagraphCard"
                                                Property="BorderThickness"
                                                Value="2" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox Grid.Row="1"
                             Margin="10,0,10,10"
                             MinHeight="0"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding SongSections}"
                             SelectedItem="{Binding SelectedSongSection}">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSongsMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="SongSectionCard"
                                        Padding="0"
                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource BorderRadius}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="SelectedSongSectionMarker"
                                                Grid.Column="0"
                                                Background="{DynamicResource AccentBrush}"
                                                Opacity="0" />

                                        <Grid Grid.Column="1"
                                              Margin="16">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DockPanel>
                                                <TextBlock Text="{Binding SectionLabel}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="15"
                                                           DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding SectionOrder, StringFormat=Section {0}}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="13"
                                                           HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,8,0,0"
                                                       Text="{Binding SectionType}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2"
                                                       Margin="0,9,0,0"
                                                       Text="{Binding PreviewText}"
                                                       FontSize="17"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="24" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                 Value="True">
                                        <Setter TargetName="SelectedSongSectionMarker"
                                                Property="Opacity"
                                                Value="1" />
                                        <Setter TargetName="SongSectionCard"
                                                Property="BorderThickness"
                                                Value="2" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ScrollViewer Grid.Row="1"
                                  Margin="20,8,20,20"
                                  MinHeight="0"
                                  VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBibleMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding PreviewHeader}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PreviewMeta}"
                                       Margin="0,8,0,20"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="15"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PreviewText}"
                                       FontSize="32"
                                       LineHeight="45"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            Margin="24"
                            Padding="22"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource BorderRadius}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsNotBibleMode}" Value="True" />
                                            <Condition Binding="{Binding IsSongsMode}" Value="False" />
                                            <Condition Binding="{Binding IsParagraphResultsEmpty}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SermonEmptyStateTitle}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="16"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          Focusable="False"
                          ShowsPreview="True"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="4"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource BorderRadius}"
                    ClipToBounds="True">
                <Grid Margin="12"
                      MinHeight="0"
                      ClipToBounds="True">
                    <Grid.Resources>
                        <Style x:Key="RightPanelButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="MinHeight" Value="34" />
                            <Setter Property="Padding" Value="6,3" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding PreviewHeader}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   LineHeight="20"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PreviewMeta}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12"
                                   LineHeight="16"
                                   TextWrapping="Wrap" />
                        <Button Margin="0,8,0,0"
                                Content="{Binding OpenDocumentButtonText}"
                                ToolTip="{loc:Tr Sermon_OpenSelectedTooltip}"
                                Command="{Binding OpenSermonCommand}"
                                CommandParameter="{Binding SelectedSermon}"
                                Visibility="{Binding IsSermonGlobalSearchMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Grid Margin="0,8,0,0"
                              Visibility="{Binding IsSermonReadingMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Author, library and document type of the open document. -->
                            <TextBlock Margin="0,0,0,6"
                                       Text="{Binding SermonReadingMeta}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBox Grid.Row="1"
                                     x:Name="SermonWithinSearchBox"
                                     Text="{Binding SermonWithinSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{loc:Tr Sermon_FindInTooltip}"
                                     VerticalContentAlignment="Center" />
                            <Grid Grid.Row="2" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Command="{Binding PreviousSermonWithinMatchCommand}"
                                        Style="{StaticResource RightPanelButtonStyle}">
                                    <TextBlock Text="{loc:Tr Sermon_PreviousMatch}" TextAlignment="Center" TextWrapping="Wrap" />
                                </Button>
                                <Button Grid.Column="2"
                                        Command="{Binding NextSermonWithinMatchCommand}"
                                        Style="{StaticResource RightPanelButtonStyle}">
                                    <TextBlock Text="{loc:Tr Sermon_NextMatch}" TextAlignment="Center" TextWrapping="Wrap" />
                                </Button>
                                <Button Grid.Column="4"
                                        Command="{Binding ClearSermonWithinSearchCommand}"
                                        Style="{StaticResource RightPanelButtonStyle}">
                                    <TextBlock Text="{loc:Tr Common_Clear}" TextAlignment="Center" TextWrapping="Wrap" />
                                </Button>
                            </Grid>
                            <TextBlock Grid.Row="3"
                                       Margin="0,5,0,0"
                                       Text="{Binding SermonWithinSearchStatus}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,8,0,8"
                                  MinHeight="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <controls:HighlightedTextBlock SourceText="{Binding PreviewText}"
                                                       HighlightQuery="{Binding PreviewHighlightQuery}"
                                                       FontSize="19"
                                                       LineHeight="26"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding RightPanelTitle}"
                                   Margin="2,0,2,4"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding ProjectCommand}"
                                    Style="{StaticResource RightPanelButtonStyle}">
                                <TextBlock Text="{loc:Tr Common_Project}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding CopyCommand}"
                                    Style="{StaticResource RightPanelButtonStyle}">
                                <TextBlock Text="{loc:Tr Common_Copy}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Button>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProjectionPages}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding ProjectionPageIndicatorText}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center" />
                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource RightPanelButtonStyle}"
                                        Command="{Binding PreviousProjectionPageCommand}">
                                    <TextBlock Text="{loc:Tr Sermon_PreviousPage}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Button>
                                <Button Grid.Column="2"
                                        Style="{StaticResource RightPanelButtonStyle}"
                                        Command="{Binding NextProjectionPageCommand}">
                                    <TextBlock Text="{loc:Tr Sermon_NextPage}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Button>
                            </Grid>
                        </Grid>

                        <Grid Margin="0,4,0,0"
                              Visibility="{Binding CanShowSelectionNavigation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource RightPanelButtonStyle}"
                                    Command="{Binding PreviousParagraphCommand}">
                                <TextBlock Text="{Binding PreviousButtonText}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Button>
                            <Button Grid.Column="2"
                                    Style="{StaticResource RightPanelButtonStyle}"
                                    Command="{Binding NextParagraphCommand}">
                                <TextBlock Text="{Binding NextButtonText}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Button>
                        </Grid>

                        <Button Margin="0,4,0,0"
                                Style="{StaticResource RightPanelButtonStyle}"
                                Command="{Binding ToggleFavoriteCommand}"
                                Visibility="{Binding IsFavoriteButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding FavoriteButtonText}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="18,8"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="{Binding ProjectionStatusText}"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="13"
                           FontWeight="SemiBold" />

                <Button Grid.Column="2"
                        Style="{StaticResource GhostButtonStyle}"
                        Content="{loc:Tr Common_Admin}"
                        Margin="16,0,0,0"
                        MinHeight="32"
                        Padding="14,5"
                        FontSize="12"
                        Click="Admin_Click"
                        ToolTip="{loc:Tr Admin_Title}" />
            </Grid>
        </Border>
    </Grid>
</Window>
