<Window x:Class="MessageFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MessageFlow.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MessageFlow"
        Height="820"
        Width="1180"
        MinHeight="500"
        MinWidth="880"
        WindowState="Maximized"
        Background="{StaticResource WindowBackgroundBrush}"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding ProjectCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}" />
        <KeyBinding Key="Right" Command="{Binding NextParagraphCommand}" />
        <KeyBinding Key="Left" Command="{Binding PreviousParagraphCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,8"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Border.Resources>
                <Style x:Key="TopToolbarTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Padding" Value="12,7" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
                <Style x:Key="TopToolbarComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
            </Border.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="MessageFlow"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,0,18,4"
                           VerticalAlignment="Center" />

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Orientation="Horizontal">
                <TextBox x:Name="SearchBox"
                          Margin="0,0,10,6"
                          MinWidth="170"
                          Width="240"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search sermons by title, code, phrase, or paragraph number"
                         VerticalContentAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource TopToolbarTextBoxStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBibleMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSongsMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <ComboBox Grid.Column="2"
                          Margin="0,0,10,6"
                          ItemsSource="{Binding AuthorFilters}"
                          SelectedItem="{Binding SelectedAuthor}"
                          DisplayMemberPath="Label"
                          TextSearch.TextPath="Label"
                          MinWidth="142"
                          Width="154"
                          VerticalContentAlignment="Center">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource TopToolbarComboBoxStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBibleMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSongsMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <ComboBox Grid.Column="3"
                          Margin="0,0,10,6"
                          ItemsSource="{Binding SourceFilters}"
                          SelectedItem="{Binding SelectedSourceFilter}"
                          DisplayMemberPath="Label"
                          TextSearch.TextPath="Label"
                          MinWidth="142"
                          Width="154"
                          VerticalContentAlignment="Center">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource TopToolbarComboBoxStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBibleMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSongsMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <ComboBox Grid.Column="4"
                          Margin="0,0,10,6"
                          ItemsSource="{Binding YearFilters}"
                          SelectedItem="{Binding SelectedYear}"
                          DisplayMemberPath="Label"
                          TextSearch.TextPath="Label"
                          MinWidth="104"
                          Width="112"
                          VerticalContentAlignment="Center">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource TopToolbarComboBoxStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBibleMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSongsMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <ComboBox Grid.Column="5"
                          Style="{StaticResource TopToolbarComboBoxStyle}"
                          Margin="0,0,8,6"
                          ItemsSource="{Binding ProjectionFontSizes}"
                          SelectedItem="{Binding SelectedProjectionFontSize}"
                          DisplayMemberPath="Label"
                          TextSearch.TextPath="Label"
                          MinWidth="124"
                          Width="132"
                          ToolTip="Projection font size"
                          VerticalContentAlignment="Center" />

                <Button Content="A-"
                        Command="{Binding DecreaseProjectionTextSizeCommand}"
                        Width="38"
                        MinHeight="40"
                        Margin="0,0,6,6"
                        Padding="0"
                        FontSize="14"
                        ToolTip="Decrease text size" />

                <Button Content="Fit"
                        Command="{Binding ResetProjectionTextSizeCommand}"
                        Width="46"
                        MinHeight="40"
                        Margin="0,0,6,6"
                        Padding="0"
                        FontSize="13"
                        ToolTip="Fit text to screen" />

                <Button Content="A+"
                        Command="{Binding IncreaseProjectionTextSizeCommand}"
                        Width="38"
                        MinHeight="40"
                        Margin="0,0,0,6"
                        Padding="0"
                        FontSize="14"
                        ToolTip="Increase text size" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="12"
              ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1.35*" MinWidth="270" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1.05*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource BorderRadius}"
                    ClipToBounds="True">
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="16,14,16,10">
                        <TextBlock Text="Library"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding LibraryCountText}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   HorizontalAlignment="Right" />
                    </DockPanel>

                    <TabControl x:Name="LibraryTabs"
                                Grid.Row="1"
                                Margin="10,0,10,10"
                                MinHeight="0"
                                ClipToBounds="True"
                                SelectionChanged="LibraryTabs_SelectionChanged">
                        <TabItem x:Name="SermonsTab"
                                 Header="Sermons">
                            <Grid Margin="0,10,0,0"
                                  MinHeight="0"
                                  ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Search sermons by title, code, phrase, or paragraph number."
                                           Margin="4,0,4,12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSermonReadingMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ListBox Grid.Row="1"
                                         MinHeight="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemsSource="{Binding SermonResults}"
                                         SelectedItem="{Binding SelectedSermon}">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSermonReadingMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="{StaticResource CardPadding}"
                                                MinHeight="92"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource BorderRadius}">
                                                 <Grid>
                                                     <Grid.RowDefinitions>
                                                         <RowDefinition Height="Auto" />
                                                         <RowDefinition Height="Auto" />
                                                         <RowDefinition Height="Auto" />
                                                         <RowDefinition Height="Auto" />
                                                         <RowDefinition Height="Auto" />
                                                     </Grid.RowDefinitions>
                                                     <TextBlock Text="{Binding Title}"
                                                                FontSize="16"
                                                                FontWeight="SemiBold"
                                                                TextWrapping="Wrap"
                                                                LineHeight="21" />
                                                     <TextBlock Grid.Row="1"
                                                                Margin="0,8,0,0"
                                                                Text="{Binding ContentTypeDisplay}"
                                                                Foreground="{StaticResource AccentBrush}"
                                                                FontSize="14"
                                                                FontWeight="SemiBold" />
                                                     <TextBlock Grid.Row="2"
                                                                Margin="0,7,0,0"
                                                                Text="{Binding MetaLine}"
                                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                                FontSize="13"
                                                                LineHeight="19"
                                                                TextWrapping="Wrap" />
                                                     <controls:HighlightedTextBlock Grid.Row="3"
                                                                                    Margin="0,7,0,0"
                                                                                    SourceText="{Binding BestMatchLine}"
                                                                                    HighlightQuery="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                                    Foreground="{StaticResource MutedTextBrush}"
                                                                                    FontSize="12"
                                                                                    LineHeight="17"
                                                                                    TextWrapping="Wrap" />
                                                     <Button Grid.Row="4"
                                                             Margin="0,10,0,0"
                                                             Content="Open Sermon"
                                                             ToolTip="Open every paragraph in this Sermon for focused reading"
                                                             Command="{Binding DataContext.OpenSermonCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                             CommandParameter="{Binding}" />
                                                 </Grid>
                                             </Border>
                                         </DataTemplate>
                                     </ListBox.ItemTemplate>
                                 </ListBox>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="BibleTab"
                                 Header="Bible">
                            <Grid Margin="0,10,0,0"
                                  MinHeight="0"
                                  ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <DockPanel Margin="4,0,4,8"
                                               LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding BibleTranslations}"
                                                  SelectedItem="{Binding SelectedBibleTranslation}"
                                                  DisplayMemberPath="DisplayName"
                                                  TextSearch.TextPath="DisplayName"
                                                  Width="154"
                                                  MinWidth="142"
                                                  Margin="12,0,0,0"
                                                  Padding="10,6"
                                                  FontSize="13"
                                                  MinHeight="38"
                                                  VerticalContentAlignment="Center">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMultipleBibleTranslations}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>

                                        <Border DockPanel.Dock="Right"
                                                Margin="12,0,0,0"
                                                Padding="10,6"
                                                Background="{StaticResource CardBackgroundBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSingleBibleTranslation}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding SelectedBibleVersionShortDisplay}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                        </Border>

                                        <TextBlock Text="Search by book, chapter, verse, or keyword."
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </DockPanel>
                                    <TextBox x:Name="BibleSearchBox"
                                             Text="{Binding BibleSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Search Bible references or keywords"
                                             VerticalContentAlignment="Center" />
                                    <TextBlock Text="Bible is not available. Open Admin Tools if setup is needed."
                                               Margin="4,8,4,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="13"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBibleUnavailable}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <ListBox x:Name="BibleNavigationList"
                                             MinHeight="0"
                                             Margin="0,12,0,12"
                                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemsSource="{Binding BibleNavigationItems}"
                                             SelectedItem="{Binding SelectedBibleNavigationItem}"
                                             MouseLeftButtonUp="BibleNavigationList_MouseLeftButtonUp">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="18,15"
                                                        MinHeight="96"
                                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource BorderRadius}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding PrimaryText}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   LineHeight="22" />
                                                        <TextBlock Grid.Row="1"
                                                                   Margin="0,7,0,0"
                                                                   Text="{Binding SecondaryText}"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Grid.Row="2"
                                                                   Margin="0,9,0,0"
                                                                   Text="{Binding PreviewText}"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                                   FontSize="14"
                                                                   LineHeight="21"
                                                                   MaxHeight="84"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border Margin="12,22,12,0"
                                            Padding="16"
                                            Background="{StaticResource CardBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource BorderRadius}"
                                            IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsBibleAvailable}" Value="True" />
                                                            <Condition Binding="{Binding IsBibleResultsEmpty}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="Ready to search the Bible."
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Search by book, chapter, verse, or keyword."
                                                       Margin="0,6,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                            </Grid>
                        </TabItem>

                        <TabItem x:Name="SongsTab"
                                 Header="Songs">
                            <Grid Margin="0,10,0,0"
                                  MinHeight="0"
                                  ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Search songs by title or lyrics."
                                               Margin="4,0,4,8"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="13"
                                               TextWrapping="Wrap" />
                                    <TextBox x:Name="SongSearchBox"
                                             Text="{Binding SongSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Search songs by title or lyrics"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <ListBox MinHeight="0"
                                             Margin="0,12,0,12"
                                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemsSource="{Binding SongResults}"
                                             SelectedItem="{Binding SelectedSong}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="{StaticResource CardPadding}"
                                                        MinHeight="92"
                                                        ToolTip="{Binding TooltipText}"
                                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource BorderRadius}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   LineHeight="21" />
                                                        <TextBlock Grid.Row="1"
                                                                   Margin="0,8,0,0"
                                                                   Text="{Binding MetaLine}"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="2"
                                                                   Margin="0,7,0,0"
                                                                   Text="{Binding LyricSnippet}"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                                   FontSize="13"
                                                                   LineHeight="19"
                                                                   MaxHeight="76"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="3"
                                                                   Margin="0,8,0,0"
                                                                   Text="{Binding FileName}"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border Margin="12,22,12,0"
                                            Padding="16"
                                            Background="{StaticResource CardBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource BorderRadius}"
                                            IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSongResultsEmpty}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="Ready to search songs."
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Search by title or lyric phrase."
                                                       Margin="0,6,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Favorites">
                            <ScrollViewer Margin="0,10,0,0"
                                          MinHeight="0"
                                          VerticalScrollBarVisibility="Visible"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Padding="16"
                                            Background="{StaticResource CardBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource BorderRadius}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavoritesEmpty}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="No favorites yet."
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Save frequently used sermon paragraphs or Bible verses for quick access."
                                                       Margin="0,6,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFavorites}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBlock Text="Sermon Favorites"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="2,0,0,10" />

                                        <ListBox x:Name="FavoritesList"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemsSource="{Binding FavoriteParagraphs}"
                                                 SelectedItem="{Binding SelectedFavoriteParagraph}"
                                                 MouseDoubleClick="FavoritesList_MouseDoubleClick">
                                            <ListBox.Style>
                                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSermonFavoritesEmpty}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="{StaticResource CardPadding}"
                                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource BorderRadius}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="{Binding SermonTitle}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Grid.Row="1"
                                                                       Margin="0,8,0,0"
                                                                       Text="{Binding Meta}"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Grid.Row="2"
                                                                       Margin="0,8,0,0"
                                                                       Text="{Binding ParagraphTextPreview}"
                                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                                       FontSize="13"
                                                                       LineHeight="18"
                                                                       MaxHeight="54"
                                                                       TextWrapping="Wrap" />
                                                            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                                                <Button Content="Project"
                                                                        MinHeight="36"
                                                                        Padding="10,6"
                                                                        FontSize="12"
                                                                        Command="{Binding DataContext.ProjectFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="Remove Favorite"
                                                                        Margin="0,8,0,0"
                                                                        MinHeight="36"
                                                                        Padding="10,6"
                                                                        FontSize="12"
                                                                        Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Border Padding="14"
                                                Margin="0,0,0,20"
                                                Background="{StaticResource CardBackgroundBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource BorderRadius}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSermonFavoritesEmpty}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="No sermon favorites yet."
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </Border>

                                        <TextBlock Text="Bible Favorites"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="2,4,0,10" />

                                        <ListBox x:Name="BibleFavoritesList"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemsSource="{Binding BibleFavoriteVerses}"
                                                 SelectedItem="{Binding SelectedBibleFavoriteVerse}"
                                                 MouseDoubleClick="BibleFavoritesList_MouseDoubleClick">
                                            <ListBox.Style>
                                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBibleFavoritesEmpty}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="{StaticResource CardPadding}"
                                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource BorderRadius}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="{Binding DisplayLine}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Grid.Row="1"
                                                                       Margin="0,8,0,0"
                                                                       Text="{Binding MetaLine}"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Grid.Row="2"
                                                                       Margin="0,8,0,0"
                                                                       Text="{Binding PreviewText}"
                                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                                       FontSize="13"
                                                                       LineHeight="18"
                                                                       MaxHeight="54"
                                                                       TextWrapping="Wrap" />
                                                            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                                                <Button Content="Project"
                                                                        MinHeight="36"
                                                                        Padding="10,6"
                                                                        FontSize="12"
                                                                        Command="{Binding DataContext.ProjectBibleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="Copy"
                                                                        Margin="0,8,0,0"
                                                                        MinHeight="36"
                                                                        Padding="10,6"
                                                                        FontSize="12"
                                                                        Command="{Binding DataContext.CopyBibleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="Remove Favorite"
                                                                        Margin="0,8,0,0"
                                                                        MinHeight="36"
                                                                        Padding="10,6"
                                                                        FontSize="12"
                                                                        Command="{Binding DataContext.RemoveBibleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Border Padding="14"
                                                Background="{StaticResource CardBackgroundBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource BorderRadius}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBibleFavoritesEmpty}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="No Bible favorites yet."
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="HistoryTab"
                                 Header="History">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="0,10,0,10">
                                    <TextBlock Text="Recent projections"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Left" />
                                    <Button Content="Clear History"
                                            Command="{Binding ClearHistoryCommand}"
                                            MinHeight="38"
                                            Padding="12,7"
                                            FontSize="13"
                                            HorizontalAlignment="Right" />
                                </DockPanel>

                                <ListBox x:Name="HistoryList"
                                         Grid.Row="1"
                                         MinHeight="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemsSource="{Binding ProjectionHistoryItems}"
                                         SelectedItem="{Binding SelectedHistoryParagraph}"
                                         MouseDoubleClick="HistoryList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="{StaticResource CardPadding}"
                                                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource BorderRadius}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding SermonTitle}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <DockPanel Grid.Row="1" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding Meta}"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   DockPanel.Dock="Left" />
                                                        <TextBlock Text="{Binding SavedAtText}"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Right" />
                                                    </DockPanel>
                                                    <TextBlock Grid.Row="2"
                                                               Margin="0,7,0,0"
                                                               Text="{Binding ParagraphTextPreview}"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               FontSize="13"
                                                               LineHeight="18"
                                                               MaxHeight="54"
                                                               TextWrapping="Wrap" />
                                                    <Button Grid.Row="3"
                                                            Content="Project"
                                                            Margin="0,12,0,0"
                                                            MinHeight="36"
                                                            Padding="10,6"
                                                            FontSize="12"
                                                            Command="{Binding DataContext.ProjectHistoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Margin="12,22,12,0"
                                        Grid.Row="1"
                                        Padding="16"
                                        Background="{StaticResource CardBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource BorderRadius}"
                                        IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProjectionHistoryEmpty}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="No projection history yet."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="14"
                                               TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          Focusable="False"
                          ShowsPreview="True"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource BorderRadius}"
                    ClipToBounds="True">
                <Grid MinHeight="0"
                      ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,16,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Margin="0,0,10,0"
                                Padding="8,4"
                                Content="← Back"
                                ToolTip="Return to the previous global Sermon results"
                                Command="{Binding BackToSermonSearchResultsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSermonReadingMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CenterPanelTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   ToolTip="{Binding CenterPanelTitle}" />
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,5,0,0"
                                   Text="{Binding StatusText}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   HorizontalAlignment="Right"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <ListBox x:Name="ParagraphResultsList"
                             Grid.Row="1"
                             Margin="10,0,10,10"
                             MinHeight="0"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding ParagraphResults}"
                             SelectedItem="{Binding SelectedParagraph}"
                             SelectionChanged="ParagraphResultsList_SelectionChanged">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBibleMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSongsMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ParagraphCard"
                                        Padding="0"
                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource BorderRadius}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="SelectedParagraphMarker"
                                                Grid.Column="0"
                                                Background="{StaticResource AccentBrush}"
                                                Opacity="0" />

                                        <Grid Grid.Column="1"
                                              Margin="16">
                                             <Grid.RowDefinitions>
                                                 <RowDefinition Height="Auto" />
                                                 <RowDefinition Height="Auto" />
                                                 <RowDefinition Height="Auto" />
                                             </Grid.RowDefinitions>
                                            <DockPanel>
                                                <TextBlock Text="{Binding ParagraphNumber, StringFormat=Paragraph {0}}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="15"
                                                           DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding PageNumber, StringFormat=Page {0}}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="13"
                                                           HorizontalAlignment="Right" />
                                            </DockPanel>
                                             <TextBlock Grid.Row="1"
                                                        Margin="0,8,0,0"
                                                        Text="{Binding MetadataLine}"
                                                        Foreground="{StaticResource MutedTextBrush}"
                                                        FontSize="13"
                                                        TextWrapping="Wrap" />
                                            <controls:HighlightedTextBlock Grid.Row="2"
                                                                           Margin="0,9,0,0"
                                                                           SourceText="{Binding ParagraphTextPreview}"
                                                                           HighlightQuery="{Binding DataContext.SermonHighlightQuery, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                           FontSize="17"
                                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                                           TextWrapping="Wrap"
                                                                           LineHeight="24"
                                                                           MaxHeight="96" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                 Value="True">
                                        <Setter TargetName="SelectedParagraphMarker"
                                                Property="Opacity"
                                                Value="1" />
                                        <Setter TargetName="ParagraphCard"
                                                Property="BorderThickness"
                                                Value="2" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox Grid.Row="1"
                             Margin="10,0,10,10"
                             MinHeight="0"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding SongSections}"
                             SelectedItem="{Binding SelectedSongSection}">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSongsMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="SongSectionCard"
                                        Padding="0"
                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource BorderRadius}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="SelectedSongSectionMarker"
                                                Grid.Column="0"
                                                Background="{StaticResource AccentBrush}"
                                                Opacity="0" />

                                        <Grid Grid.Column="1"
                                              Margin="16">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DockPanel>
                                                <TextBlock Text="{Binding SectionLabel}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="15"
                                                           DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding SectionOrder, StringFormat=Section {0}}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="13"
                                                           HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,8,0,0"
                                                       Text="{Binding SectionType}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2"
                                                       Margin="0,9,0,0"
                                                       Text="{Binding PreviewText}"
                                                       FontSize="17"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="24" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                 Value="True">
                                        <Setter TargetName="SelectedSongSectionMarker"
                                                Property="Opacity"
                                                Value="1" />
                                        <Setter TargetName="SongSectionCard"
                                                Property="BorderThickness"
                                                Value="2" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ScrollViewer Grid.Row="1"
                                  Margin="20,8,20,20"
                                  MinHeight="0"
                                  VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBibleMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding PreviewHeader}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PreviewMeta}"
                                       Margin="0,8,0,20"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="15"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PreviewText}"
                                       FontSize="32"
                                       LineHeight="45"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            Margin="24"
                            Padding="22"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource BorderRadius}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsNotBibleMode}" Value="True" />
                                            <Condition Binding="{Binding IsSongsMode}" Value="False" />
                                            <Condition Binding="{Binding IsParagraphResultsEmpty}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Ready to search sermons."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="16"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          Focusable="False"
                          ShowsPreview="True"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="4"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource BorderRadius}"
                    ClipToBounds="True">
                <Grid Margin="12"
                      MinHeight="0"
                      ClipToBounds="True">
                    <Grid.Resources>
                        <Style x:Key="RightPanelButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="MinHeight" Value="34" />
                            <Setter Property="Padding" Value="6,3" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding PreviewHeader}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   LineHeight="20"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PreviewMeta}"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   LineHeight="16"
                                   TextWrapping="Wrap" />
                        <Button Margin="0,8,0,0"
                                Content="Open Sermon"
                                ToolTip="Open every paragraph in the selected Sermon for focused reading"
                                Command="{Binding OpenSermonCommand}"
                                CommandParameter="{Binding SelectedSermon}"
                                Visibility="{Binding IsSermonGlobalSearchMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Grid Margin="0,8,0,0"
                              Visibility="{Binding IsSermonReadingMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="SermonWithinSearchBox"
                                     Text="{Binding SermonWithinSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Find in selected sermon"
                                     VerticalContentAlignment="Center" />
                            <Grid Grid.Row="1" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Command="{Binding PreviousSermonWithinMatchCommand}"
                                        Style="{StaticResource RightPanelButtonStyle}">
                                    <TextBlock Text="Previous Match" TextAlignment="Center" TextWrapping="Wrap" />
                                </Button>
                                <Button Grid.Column="2"
                                        Command="{Binding NextSermonWithinMatchCommand}"
                                        Style="{StaticResource RightPanelButtonStyle}">
                                    <TextBlock Text="Next Match" TextAlignment="Center" TextWrapping="Wrap" />
                                </Button>
                                <Button Grid.Column="4"
                                        Command="{Binding ClearSermonWithinSearchCommand}"
                                        Style="{StaticResource RightPanelButtonStyle}">
                                    <TextBlock Text="Clear" TextAlignment="Center" TextWrapping="Wrap" />
                                </Button>
                            </Grid>
                            <TextBlock Grid.Row="2"
                                       Margin="0,5,0,0"
                                       Text="{Binding SermonWithinSearchStatus}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,8,0,8"
                                  MinHeight="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <controls:HighlightedTextBlock SourceText="{Binding PreviewText}"
                                                       HighlightQuery="{Binding PreviewHighlightQuery}"
                                                       FontSize="19"
                                                       LineHeight="26"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding RightPanelTitle}"
                                   Margin="2,0,2,4"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding ProjectCommand}"
                                    Style="{StaticResource RightPanelButtonStyle}">
                                <TextBlock Text="Project"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding CopyCommand}"
                                    Style="{StaticResource RightPanelButtonStyle}">
                                <TextBlock Text="Copy"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Button>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProjectionPages}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding ProjectionPageIndicatorText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center" />
                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource RightPanelButtonStyle}"
                                        Command="{Binding PreviousProjectionPageCommand}">
                                    <TextBlock Text="Previous Page"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Button>
                                <Button Grid.Column="2"
                                        Style="{StaticResource RightPanelButtonStyle}"
                                        Command="{Binding NextProjectionPageCommand}">
                                    <TextBlock Text="Next Page"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Button>
                            </Grid>
                        </Grid>

                        <Grid Margin="0,4,0,0"
                              Visibility="{Binding CanShowSelectionNavigation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource RightPanelButtonStyle}"
                                    Command="{Binding PreviousParagraphCommand}">
                                <TextBlock Text="{Binding PreviousButtonText}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Button>
                            <Button Grid.Column="2"
                                    Style="{StaticResource RightPanelButtonStyle}"
                                    Command="{Binding NextParagraphCommand}">
                                <TextBlock Text="{Binding NextButtonText}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Button>
                        </Grid>

                        <Button Margin="0,4,0,0"
                                Style="{StaticResource RightPanelButtonStyle}"
                                Command="{Binding ToggleFavoriteCommand}"
                                Visibility="{Binding IsFavoriteButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding FavoriteButtonText}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="14,5"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="{Binding ProjectionStatusText}"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="13"
                           FontWeight="SemiBold" />

                <Button Grid.Column="2"
                        Content="Admin"
                        Margin="14,0,0,0"
                        MinHeight="28"
                        Padding="12,4"
                        FontSize="12"
                        Click="Admin_Click"
                        ToolTip="Open Admin Tools (Ctrl+Shift+A)" />
            </Grid>
        </Border>
    </Grid>
</Window>
