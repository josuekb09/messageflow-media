<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Default operator chrome. Keep these values aligned with the original App.xaml palette. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F141C" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#151B24" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1E2633" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1A2230" />
    <SolidColorBrush x:Key="BorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />
