<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Clean, professional light theme tokens (central theme resources) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryPanelBrush" Color="#EEF1F6" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE8" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#4B5563" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="SelectionFillBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="HoverFillBrush" Color="#EEF1F6" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GhostButtonHoverBackgroundBrush" Color="#EEF1F6" />
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#D8DEE8" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="ComboBoxItemHighlightBrush" Color="#EEF1F6" />
    <SolidColorBrush x:Key="ComboBoxItemSelectedBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#D8DEE8" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="HighlightBackgroundBrush" Color="#FEF08A" />
    <SolidColorBrush x:Key="HighlightForegroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="TextSelectionForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ReferenceEmphasisBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#B91C1C" />

    <!-- Projection window tokens in light theme -->
    <SolidColorBrush x:Key="ProjectionBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ProjectionTextBrush" Color="#111827" />
    <SolidColorBrush x:Key="ProjectionTitleBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="ProjectionIndicatorBrush" Color="#4B5563" />
</ResourceDictionary>
