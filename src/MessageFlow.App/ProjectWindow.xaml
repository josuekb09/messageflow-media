<Window x:Class="MessageFlow.App.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MessageFlow Projection"
        Height="720"
        Width="1100"
        MinHeight="520"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Black"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid x:Name="ProjectionRoot"
          Background="Black"
          Margin="80,56,80,44">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock"
                   Grid.Row="0"
                   Text="{Binding ProjectionParagraphTitle}"
                   Foreground="White"
                   FontSize="28"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   MaxHeight="74" />

        <TextBlock x:Name="ParagraphNumberTextBlock"
                   Grid.Row="1"
                   Text="{Binding ProjectionParagraphNumber}"
                   Margin="0,18,0,36"
                   Foreground="White"
                   FontSize="22"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   HorizontalAlignment="Center" />

        <Grid x:Name="ParagraphStage"
              Grid.Row="2"
              ClipToBounds="True">
            <TextBlock x:Name="ParagraphTextBlock"
                       Foreground="White"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center" />
        </Grid>

        <TextBlock x:Name="PageIndicatorTextBlock"
                   Grid.Row="3"
                   Margin="0,24,0,0"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Right"
                   TextAlignment="Right" />
    </Grid>
</Window>
