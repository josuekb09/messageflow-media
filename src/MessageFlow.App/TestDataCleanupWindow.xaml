<Window x:Class="MessageFlow.App.TestDataCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MessageFlow.App.Localization"
        Title="{loc:Tr Cleanup_Title}"
        Height="600"
        Width="760"
        MinHeight="520"
        MinWidth="640"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">
            <TextBlock Text="Cleanup Test Data"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding Summary}"
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="14"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Sources}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12"
                                    Padding="16"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource BorderRadius}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SourceTypeDisplay}"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Folder}"
                                               Margin="0,7,0,12"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="13"
                                               TextWrapping="Wrap">
                                        <Run Text="Documents: " />
                                        <Run Text="{Binding DocumentCount, StringFormat={}{0:N0}}" />
                                        <Run Text="  Paragraphs: " />
                                        <Run Text="{Binding ParagraphCount, StringFormat={}{0:N0}}" />
                                        <Run Text="  Favorites: " />
                                        <Run Text="{Binding FavoriteCount, StringFormat={}{0:N0}}" />
                                        <Run Text="  History: " />
                                        <Run Text="{Binding HistoryCount, StringFormat={}{0:N0}}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,10,0,0"
                        Padding="16"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource BorderRadius}">
                    <StackPanel>
                        <TextBlock Text="Type this confirmation phrase to continue:"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="13" />
                        <TextBlock Text="I understand this removes test source data only."
                                   Margin="0,8,0,8"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBox x:Name="ConfirmationBox"
                                 TextChanged="ConfirmationBox_TextChanged" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="0,20,0,0"
                Padding="0,16,0,0"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="118" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="A database backup will be created before anything is deleted."
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button x:Name="CleanupButton"
                        Grid.Column="1"
                        Content="Cleanup Test Data"
                        IsEnabled="False"
                        Click="Cleanup_Click" />
                <Button Grid.Column="3"
                        Content="Cancel"
                        Click="Cancel_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
