<Window x:Class="MessageFlow.App.AdminToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Tools"
        Height="820"
        Width="1180"
        MinHeight="720"
        MinWidth="1040"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,22">
            <TextBlock Text="Admin Tools"
                       FontSize="28"
                       FontWeight="SemiBold" />
            <TextBlock Text="Admin tools are for setup and maintenance. They are not needed during normal service."
                       Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="14"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <UniformGrid Columns="2"
                         Rows="3">
                <Border Margin="0,0,14,14"
                        Padding="{StaticResource CardPadding}"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource BorderRadius}">
                    <StackPanel>
                        <TextBlock Text="Content Sources"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Manage local content sources."
                                   Margin="0,7,0,16"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                        <Button Content="Manage Sources"
                                Command="{Binding ManageSourcesCommand}" />
                        <Button Content="Add Source"
                                Margin="0,10,0,0"
                                Command="{Binding AddNewSourceCommand}" />
                        <Button Content="Import Source"
                                Margin="0,10,0,0"
                                Command="{Binding ImportSourceCommand}" />
                    </StackPanel>
                </Border>

                <Border Margin="14,0,0,14"
                        Padding="{StaticResource CardPadding}"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource BorderRadius}">
                    <StackPanel>
                        <TextBlock Text="Bible"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentBibleTranslationDisplay}"
                                   Margin="0,7,0,4"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrentBibleVerseCountDisplay}"
                                   Margin="0,0,0,16"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <Button Content="Import Bible"
                                Command="{Binding ImportBibleCommand}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,14,14,14"
                        Padding="{StaticResource CardPadding}"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource BorderRadius}">
                    <StackPanel>
                        <TextBlock Text="Database Safety"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Keep a safe copy before big imports or cleanup."
                                   Margin="0,7,0,16"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                        <Button Content="Backup Database"
                                Command="{Binding BackupDatabaseCommand}" />
                        <Button Content="Restore Database"
                                Margin="0,10,0,0"
                                Command="{Binding RestoreDatabaseCommand}" />
                        <Button Content="Open Backup Folder"
                                Margin="0,10,0,0"
                                Command="{Binding OpenBackupFolderCommand}" />
                    </StackPanel>
                </Border>

                <Border Margin="14,14,0,14"
                        Padding="{StaticResource CardPadding}"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource BorderRadius}">
                    <StackPanel>
                        <TextBlock Text="Maintenance"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Run checks and careful cleanup before production use."
                                   Margin="0,7,0,16"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                        <Button Content="Verify Production Data"
                                Command="{Binding VerifyProductionDataCommand}" />
                        <Button Content="Cleanup Test Data"
                                Margin="0,10,0,0"
                                Command="{Binding CleanupTestDataCommand}" />
                        <Button Content="Repair Source Metadata"
                                Margin="0,10,0,0"
                                Command="{Binding RepairSourceMetadataCommand}" />
                        <Button Content="Cleanup Brother Frank Circular Letters"
                                Margin="0,10,0,0"
                                Command="{Binding CleanupBrotherFrankCircularLettersCommand}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,14,14,0"
                        Padding="{StaticResource CardPadding}"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource BorderRadius}">
                    <StackPanel>
                        <TextBlock Text="Projection Display"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProjectionStatusText}"
                                   Margin="0,7,0,16"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{Binding ProjectionDisplayOptions}"
                                  SelectedItem="{Binding SelectedProjectionDisplayOption}"
                                  DisplayMemberPath="Label"
                                  TextSearch.TextPath="Label"
                                  MinHeight="36"
                                  VerticalContentAlignment="Center" />
                        <Button Content="Test Projection Display"
                                Margin="0,10,0,0"
                                Command="{Binding TestProjectionDisplayCommand}" />
                        <Button Content="Refresh Displays"
                                Margin="0,10,0,0"
                                Command="{Binding RefreshProjectionDisplaysCommand}" />
                    </StackPanel>
                </Border>

                <Border Margin="14,14,0,0"
                        Padding="{StaticResource CardPadding}"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource BorderRadius}">
                    <StackPanel>
                        <Expander Header="Advanced"
                                  Foreground="{StaticResource SecondaryTextBrush}">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="KJV converter"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Local converter: tools\ConvertKjvToCsv. It is not run automatically."
                                           Margin="0,7,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="0,20,0,0"
                Padding="0,16,0,0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="118" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        Content="Close"
                        Click="Close_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
