<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MessageFlow.Core\MessageFlow.Core.csproj" />
    <ProjectReference Include="..\MessageFlow.Data\MessageFlow.Data.csproj" />
    <ProjectReference Include="..\MessageFlow.Importer\MessageFlow.Importer.csproj" />
    <ProjectReference Include="..\MessageFlow.Search\MessageFlow.Search.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\Brand\MessageFlow.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Brand\messageflow-mark-256.png" />
  </ItemGroup>

</Project>
